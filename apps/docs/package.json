{
  "name": "docs",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "demo-code:check": "node scripts/check-demo-code.mjs",
    "pages:dev": "pnpm build && pnpm dlx wrangler pages dev dist",
    "db:create": "pnpm dlx wrangler d1 create chufix-comments",
    "db:migrate:local": "pnpm dlx wrangler d1 migrations apply chufix-comments --local",
    "db:migrate:remote": "pnpm dlx wrangler d1 migrations apply chufix-comments --remote",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/react": "^3.6.2",
    "@astrojs/vue": "^4.5.3",
    "astro": "^4.16.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "vue": "^3.5.12",
    "@chufix-design/icons": "workspace:*",
    "@chufix-design/react": "workspace:*",
    "@chufix-design/tokens": "workspace:*",
    "@chufix-design/vue": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
