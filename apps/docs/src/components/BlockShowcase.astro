---
import { getLocaleFromUrl } from '~/i18n/utils';
import { t } from '~/i18n/strings';
import DocCodeWorkspace from './DocCodeWorkspace.astro';
import { asSingleBundle } from './docCode';

/**
 * Multi-file code showcase for Blocks pages — preview + file-tab code view.
 */
export interface BlockFile {
  name: string;
  content: string;
  lang: 'vue' | 'tsx' | 'ts' | 'js' | 'json' | 'css' | 'bash' | 'mdx';
}
interface Props {
  id: string;
  files: BlockFile[];
  cli?: string;
  previewHeight?: number | string;
}
const { id, files, cli, previewHeight } = Astro.props;
const bundles = [asSingleBundle(files, 'Source')];
const locale = getLocaleFromUrl(Astro.url);
const heightStyle =
  previewHeight != null
    ? typeof previewHeight === 'number'
      ? `${previewHeight}px`
      : previewHeight
    : '480px';
---

<section class="cf-block" data-block-showcase data-block-id={id}>
  <header class="cf-block__bar">
    <div class="cf-block__modes" role="tablist" aria-label={t(locale, 'block.aria.modes')}>
      <button class="cf-block__mode" data-mode="preview" aria-selected="true">{t(locale, 'block.modes.preview')}</button>
      <button class="cf-block__mode" data-mode="code" aria-selected="false">{t(locale, 'block.modes.code')}</button>
    </div>
    {cli && (
      <div class="cf-block__cli">
        <code>{cli}</code>
        <button class="cf-block__copy" type="button" data-copy={cli} title={t(locale, 'block.copy.cli')} data-copy-label={t(locale, 'block.copy.copy')} data-copied-label={t(locale, 'block.copy.copied')}>{t(locale, 'block.copy.copy')}</button>
      </div>
    )}
  </header>

  <div class="cf-block__body">
    <div class="cf-block__preview" data-pane="preview" data-active="true" style={`min-height: ${heightStyle};`}>
      <div class="cf-block__preview-frame">
        <slot />
      </div>
    </div>
    <div class="cf-block__code" data-pane="code" data-active="false">
      <DocCodeWorkspace bundles={bundles} title={`${id} source`} rootLabel={`blocks/${id}`} height="min(720px, 72vh)" />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-block-showcase]').forEach((root) => {
    const modeBtns = root.querySelectorAll<HTMLButtonElement>('.cf-block__mode');
    const panes = root.querySelectorAll<HTMLElement>('[data-pane]');

    modeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.mode!;
        modeBtns.forEach((x) => x.setAttribute('aria-selected', x === b ? 'true' : 'false'));
        panes.forEach((p) => (p.dataset.active = p.dataset.pane === mode ? 'true' : 'false'));
      }),
    );

    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
      b.addEventListener('click', async () => {
        const txt = b.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(txt);
          const orig = b.dataset.copyLabel ?? b.textContent ?? '';
          const copied = b.dataset.copiedLabel ?? orig;
          b.textContent = copied;
          setTimeout(() => (b.textContent = orig), 1500);
        } catch {}
      }),
    );
  });
</script>
