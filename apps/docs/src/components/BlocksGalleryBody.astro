---
import CategoryTabs from '~/components/CategoryTabs.astro';
import { blocks } from '~/blocks/registry';
import { CATEGORIES } from '~/blocks/types';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const isEn = locale === 'en';
const heroTitle = isEn ? 'Blocks · page templates' : 'Blocks 页面方案';
const heroLede = isEn
  ? "ChuFix isn't just atoms — these are full-page recipes assembled from atoms. Each block ships with its complete Vue source plus optional decomposition. Open the code panel and paste it into your own app."
  : 'ChuFix 不只是 atoms — 这里是把 atoms 拼成完整页面的"成品菜谱"。每个 block 都包含完整 Vue 单文件 + 多文件分解（如有），点开看代码即可粘贴到自己应用里。';

const grouped = CATEGORIES.map((cat) => ({
  ...cat,
  items: blocks.filter((b) => b.category === cat.id),
}));
const defaultCat = CATEGORIES[0].id;

function previewKind(category: string) {
  if (category === 'dashboards') return 'dashboard';
  if (category === 'auth') return 'auth';
  if (category === 'errors') return 'error';
  if (category === 'workbench') return 'workbench';
  if (category === 'pricing' || category === 'billing') return 'billing';
  if (category === 'team' || category === 'settings' || category === 'profile') return 'settings';
  return 'workspace';
}
---

<div class="blocks-page">
  <header class="blocks-hero">
    <h1 class="blocks-hero__title">{heroTitle}</h1>
    <p class="blocks-hero__lede">{heroLede}</p>
  </header>

  <CategoryTabs tabs={grouped.map((g) => ({ id: g.id, label: g.label }))} defaultId={defaultCat}>
    {grouped.map((g) => (
      <div data-cat-panel={g.id} data-active={g.id === defaultCat ? 'true' : 'false'}>
        <p class="blocks-page__cat-desc">{g.description}</p>
        <div class="cf-gallery">
          {g.items.map((b) => (
            <a class="cf-gallery-card" href={prefixHref(`/blocks/${b.id}/`, locale)}>
              <div class:list={['cf-gallery-card__preview', 'block-thumb', `block-thumb--${previewKind(b.category)}`]} aria-hidden="true">
                <div class="block-thumb__window">
                  <div class="block-thumb__topbar">
                    <span></span>
                    <span></span>
                    <span></span>
                    <i>{b.files[0]?.name ?? b.id}</i>
                  </div>
                  <div class="block-thumb__body">
                    <aside class="block-thumb__rail">
                      <span></span>
                      <span></span>
                      <span></span>
                    </aside>
                    <main class="block-thumb__main">
                      <div class="block-thumb__hero">
                        <span></span>
                        <span></span>
                      </div>
                      <div class="block-thumb__grid">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                      </div>
                      <div class="block-thumb__rows">
                        <span></span>
                        <span></span>
                        <span></span>
                      </div>
                    </main>
                  </div>
                </div>
              </div>
              <div class="cf-gallery-card__body">
                <div class="cf-gallery-card__name">{b.name}</div>
                <div class="cf-gallery-card__desc">{b.description}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </CategoryTabs>
</div>

<style>
  .blocks-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    font-family: var(--font-sans);
  }
  .blocks-page__cat-desc {
    color: var(--fg-3);
    font-size: var(--t-12);
    margin: 0 0 14px;
  }
  .block-thumb {
    min-height: 230px;
    padding: 14px;
    align-items: stretch;
    justify-content: stretch;
    background:
      linear-gradient(180deg, color-mix(in oklch, var(--bg-inset), var(--accent-soft) 18%), var(--bg-inset)),
      var(--bg-inset);
  }
  .block-thumb__window {
    width: 100%;
    min-height: 202px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line-1);
    border-radius: var(--r-6);
    background: var(--bg-0);
    box-shadow: var(--shadow-1);
  }
  .block-thumb__topbar {
    height: 30px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    border-bottom: 1px solid var(--line-1);
    background: var(--bg-1);
  }
  .block-thumb__topbar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .block-thumb__topbar i {
    margin-left: 6px;
    color: var(--fg-3);
    font-family: var(--font-mono);
    font-size: 10px;
    font-style: normal;
    white-space: nowrap;
  }
  .block-thumb__body {
    flex: 1;
    display: grid;
    grid-template-columns: 72px 1fr;
    min-height: 0;
  }
  .block-thumb__rail {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 10px;
    border-right: 1px solid var(--line-1);
    background: var(--bg-2);
  }
  .block-thumb__rail span,
  .block-thumb__hero span,
  .block-thumb__grid span,
  .block-thumb__rows span {
    display: block;
    border-radius: var(--r-3);
    background: color-mix(in oklch, var(--accent-1), var(--bg-2) 74%);
  }
  .block-thumb__rail span {
    height: 8px;
  }
  .block-thumb__rail span:nth-child(1) { width: 42px; }
  .block-thumb__rail span:nth-child(2) { width: 34px; opacity: 0.65; }
  .block-thumb__rail span:nth-child(3) { width: 48px; opacity: 0.45; }
  .block-thumb__main {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 12px;
    padding: 14px;
  }
  .block-thumb__hero {
    display: grid;
    gap: 7px;
  }
  .block-thumb__hero span:nth-child(1) { width: 52%; height: 12px; }
  .block-thumb__hero span:nth-child(2) { width: 72%; height: 8px; opacity: 0.55; }
  .block-thumb__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }
  .block-thumb__grid span {
    min-height: 44px;
    background: var(--bg-1);
    border: 1px solid var(--line-1);
  }
  .block-thumb__rows {
    display: grid;
    gap: 6px;
  }
  .block-thumb__rows span {
    height: 7px;
    opacity: 0.5;
  }
  .block-thumb__rows span:nth-child(2) { width: 82%; }
  .block-thumb__rows span:nth-child(3) { width: 64%; }
  .block-thumb--dashboard .block-thumb__grid span:nth-child(1),
  .block-thumb--billing .block-thumb__grid span:nth-child(2),
  .block-thumb--workbench .block-thumb__rail,
  .block-thumb--settings .block-thumb__hero span:nth-child(1) {
    background: color-mix(in oklch, var(--accent-soft), var(--bg-1) 42%);
  }
  .block-thumb--auth .block-thumb__body {
    grid-template-columns: 1fr;
  }
  .block-thumb--auth .block-thumb__rail {
    display: none;
  }
  .block-thumb--auth .block-thumb__main {
    max-width: 210px;
    width: 76%;
    justify-self: center;
    align-self: center;
    border: 1px solid var(--line-1);
    border-radius: var(--r-6);
    background: var(--bg-1);
  }
  .block-thumb--error .block-thumb__grid {
    grid-template-columns: 1fr;
  }
  .block-thumb--error .block-thumb__grid span {
    min-height: 86px;
  }
</style>
