---
import CategoryTabs from '~/components/CategoryTabs.astro';
import BlockPreview from '~/components/BlockPreview.vue';
import { blocks } from '~/blocks/registry';
import { CATEGORIES } from '~/blocks/types';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const isEn = locale === 'en';
const heroTitle = isEn ? 'Blocks · page templates' : 'Blocks 页面方案';
const heroLede = isEn
  ? "ChuFix isn't just atoms — these are full-page recipes assembled from atoms. Each block ships with its complete Vue source plus optional decomposition. Open the code panel and paste it into your own app."
  : 'ChuFix 不只是 atoms — 这里是把 atoms 拼成完整页面的"成品菜谱"。每个 block 都包含完整 Vue 单文件 + 多文件分解（如有），点开看代码即可粘贴到自己应用里。';

const grouped = CATEGORIES.map((cat) => ({
  ...cat,
  items: blocks.filter((b) => b.category === cat.id),
}));
const defaultCat = CATEGORIES[0].id;

const thumbProfiles = {
  templates: [
    { h: 300, scale: 0.58, x: -2, y: 0 },
    { h: 360, scale: 0.62, x: -10, y: -18 },
    { h: 270, scale: 0.66, x: -18, y: -52 },
  ],
  dashboards: [
    { h: 320, scale: 0.58, x: -8, y: -20 },
    { h: 280, scale: 0.64, x: -18, y: -54 },
    { h: 380, scale: 0.56, x: 0, y: 0 },
  ],
  auth: [
    { h: 280, scale: 0.66, x: -60, y: -30 },
    { h: 340, scale: 0.6, x: -24, y: -12 },
  ],
  errors: [
    { h: 260, scale: 0.68, x: -42, y: -42 },
    { h: 320, scale: 0.6, x: -10, y: -8 },
  ],
  workbench: [
    { h: 330, scale: 0.57, x: -10, y: -4 },
    { h: 290, scale: 0.64, x: -36, y: -48 },
  ],
  settings: [
    { h: 300, scale: 0.6, x: -12, y: -18 },
    { h: 350, scale: 0.56, x: 0, y: 0 },
  ],
  profile: [
    { h: 300, scale: 0.62, x: -28, y: -20 },
    { h: 360, scale: 0.58, x: -10, y: -8 },
  ],
  pricing: [
    { h: 330, scale: 0.58, x: -10, y: -8 },
    { h: 280, scale: 0.64, x: -36, y: -52 },
  ],
  billing: [
    { h: 320, scale: 0.58, x: -10, y: -12 },
    { h: 280, scale: 0.64, x: -34, y: -52 },
  ],
  team: [
    { h: 300, scale: 0.6, x: -18, y: -18 },
    { h: 360, scale: 0.56, x: 0, y: 0 },
  ],
};

function thumbStyle(category: string, index: number) {
  const profiles = thumbProfiles[category as keyof typeof thumbProfiles] || thumbProfiles.templates;
  const profile = profiles[index % profiles.length];
  return `--thumb-h:${profile.h}px;--thumb-scale:${profile.scale};--thumb-x:${profile.x}px;--thumb-y:${profile.y}px;`;
}
---

<div class="blocks-page">
  <header class="blocks-hero">
    <h1 class="blocks-hero__title">{heroTitle}</h1>
    <p class="blocks-hero__lede">{heroLede}</p>
  </header>

  <CategoryTabs tabs={grouped.map((g) => ({ id: g.id, label: g.label }))} defaultId={defaultCat}>
    {grouped.map((g) => (
      <div data-cat-panel={g.id} data-active={g.id === defaultCat ? 'true' : 'false'}>
        <p class="blocks-page__cat-desc">{g.description}</p>
        <div class="cf-gallery cf-gallery--masonry">
          {g.items.map((b, index) => (
            <article class={`cf-gallery-card block-card block-card--${b.category}`} style={thumbStyle(b.category, index)}>
              <div class="cf-gallery-card__preview block-thumb" aria-hidden="true">
                <div class="block-thumb__stage">
                  <BlockPreview blockId={b.id} client:visible />
                </div>
              </div>
              <a class="cf-gallery-card__body" href={prefixHref(`/blocks/${b.id}/`, locale)}>
                <div class="cf-gallery-card__name">{b.name}</div>
                <div class="cf-gallery-card__desc">{b.description}</div>
              </a>
            </article>
          ))}
        </div>
      </div>
    ))}
  </CategoryTabs>
</div>

<style>
  .blocks-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    font-family: var(--font-sans);
  }
  .blocks-page__cat-desc {
    color: var(--fg-3);
    font-size: var(--t-12);
    margin: 0 0 14px;
  }
  .cf-gallery--masonry {
    display: block;
    columns: 3 340px;
    column-gap: 16px;
  }
  .block-card {
    display: inline-flex;
    width: 100%;
    margin: 0 0 16px;
    break-inside: avoid;
  }
  .block-thumb {
    height: var(--thumb-h, 300px);
    min-height: 0;
    aspect-ratio: auto;
    padding: 0;
    align-items: stretch;
    justify-content: stretch;
    background:
      linear-gradient(180deg, color-mix(in oklch, var(--bg-inset), var(--accent-soft) 18%), var(--bg-inset)),
      var(--bg-inset);
  }
  .block-thumb__stage {
    width: 900px;
    min-height: 680px;
    pointer-events: none;
    transform: translate(var(--thumb-x, 0), var(--thumb-y, 0)) scale(var(--thumb-scale, 0.6));
    transform-origin: 0 0;
  }
  .block-thumb__stage :global(.cf-block-preview-shell),
  .block-thumb__stage :global(.cf-app-shell),
  .block-thumb__stage :global(.cf-card),
  .block-thumb__stage :global(.cf-page) {
    box-shadow: none;
  }
  .cf-gallery-card {
    cursor: default;
  }
  .cf-gallery-card__body {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 760px) {
    .cf-gallery--masonry {
      columns: 1;
    }
    .block-thumb__stage {
      width: 760px;
      transform: translate(var(--thumb-x, 0), var(--thumb-y, 0)) scale(0.5);
    }
  }
</style>
