---
import { Code } from 'astro:components';
import DocCodeWorkspace from './DocCodeWorkspace.astro';

interface Props {
  vueCode?: string;
  vueSource?: string;
  reactCode?: string;
  reactSource?: string;
  cliCode?: string;
  cliSource?: string;
  variant?: 'default' | 'wide' | 'compact';
  codeLayout?: 'tabs' | 'workspace';
}
type DocCodeFile = {
  id: string;
  label: string;
  name: string;
  content: string;
  lang: 'vue' | 'tsx' | 'jsx' | 'bash';
};
const {
  vueCode,
  vueSource,
  reactCode,
  reactSource,
  cliCode,
  cliSource,
  variant = 'default',
  codeLayout = 'tabs',
} = Astro.props;

const codeTabs: DocCodeFile[] = [];
const vueContent = normalizeCode(vueSource ?? vueCode);
const reactContent = normalizeCode(reactSource ?? reactCode);
const cliContent = normalizeCode(cliSource ?? cliCode);

function normalizeCode(value?: string) {
  return String(value || '')
    .replace(/\r\n?/g, '\n')
    .trim()
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n{3,}/g, '\n\n');
}

function hasTypeScript(value: string) {
  return /lang=["']ts["']|\bimport\s+type\b|\binterface\s+\w+|\btype\s+\w+\s*=|:\s*[A-Za-z_$][\w$<>,\s[\]|&?]*(?=\s*[=,)])/m.test(value);
}

function toJavaScript(value: string) {
  return normalizeCode(value)
    .replace(/\s+lang=["']ts["']/g, '')
    .replace(/^\s*import\s+type\s+[^;]+;\n?/gm, '')
    .replace(/,\s*type\s+([A-Za-z_$][\w$]*)/g, '')
    .replace(/\{\s*type\s+([A-Za-z_$][\w$]*)\s*,\s*/g, '{ ')
    .replace(/\{\s*type\s+([A-Za-z_$][\w$]*)\s*\}/g, '{}')
    .replace(/^\s*export\s+interface\s+\w+[^{]*\{[\s\S]*?\n\}\n?/gm, '')
    .replace(/^\s*interface\s+\w+[^{]*\{[\s\S]*?\n\}\n?/gm, '')
    .replace(/^\s*export\s+type\s+\w+\s*=[^;]+;\n?/gm, '')
    .replace(/^\s*type\s+\w+\s*=[^;]+;\n?/gm, '')
    .replace(/(\b(?:const|let|var)\s+[A-Za-z_$][\w$]*)\s*:\s*[^=]+(?=\s*=)/g, '$1')
    .replace(/([,(]\s*[A-Za-z_$][\w$]*)\s*:\s*[A-Za-z_$][\w$<>,\s[\]|&?]*(?=\s*(?:,|\)))/g, '$1')
    .replace(/\s+as\s+const\b/g, '')
    .replace(/\s+as\s+[A-Za-z_$][\w$<>,\s[\]|&?]*/g, '');
}

if (vueContent) {
  const vueIsTs = hasTypeScript(vueContent);
  codeTabs.push({ id: 'vue-ts', label: vueIsTs ? 'Vue TS' : 'Vue', name: 'src/App.vue', content: vueContent, lang: 'vue' });
  if (vueIsTs) codeTabs.push({ id: 'vue-js', label: 'Vue JS', name: 'src/App.vue', content: toJavaScript(vueContent), lang: 'vue' });
}
if (reactContent) {
  codeTabs.push({ id: 'react-ts', label: 'React TS', name: 'src/App.tsx', content: reactContent, lang: 'tsx' });
  codeTabs.push({ id: 'react-js', label: 'React JS', name: 'src/App.jsx', content: toJavaScript(reactContent), lang: 'jsx' });
}
if (cliContent) codeTabs.push({ id: 'cli', label: 'CLI', name: 'scripts/setup.sh', content: cliContent, lang: 'bash' });
---

<div class:list={['cf-demo', variant !== 'default' && `cf-demo--${variant}`]} data-demo-frame>
  <div class="cf-demo__preview">
    <div class="cf-demo__preview-tools" aria-label="预览背景">
      <span class="cf-demo__preview-tools-label">背景</span>
      <button
        class="cf-demo__bg-option"
        type="button"
        data-demo-bg="transparent"
        data-active="true"
        aria-label="透明背景"
        title="透明背景"
      >
        <span class="cf-demo__bg-swatch cf-demo__bg-swatch--transparent"></span>
      </button>
      <button
        class="cf-demo__bg-option"
        type="button"
        data-demo-bg="light"
        aria-label="白色背景"
        title="白色背景"
      >
        <span class="cf-demo__bg-swatch cf-demo__bg-swatch--light"></span>
      </button>
      <button
        class="cf-demo__bg-option"
        type="button"
        data-demo-bg="muted"
        aria-label="浅灰背景"
        title="浅灰背景"
      >
        <span class="cf-demo__bg-swatch cf-demo__bg-swatch--muted"></span>
      </button>
      <button
        class="cf-demo__bg-option"
        type="button"
        data-demo-bg="dark"
        aria-label="深色背景"
        title="深色背景"
      >
        <span class="cf-demo__bg-swatch cf-demo__bg-swatch--dark"></span>
      </button>
      <button
        class="cf-demo__bg-option"
        type="button"
        data-demo-bg="accent"
        aria-label="品牌淡色背景"
        title="品牌淡色背景"
      >
        <span class="cf-demo__bg-swatch cf-demo__bg-swatch--accent"></span>
      </button>
    </div>
    <div class="cf-demo__pane-content">
      <slot />
    </div>
  </div>

  {codeTabs.length > 0 && (
    <div class="cf-demo__code-section" data-collapsed="true">
      <button
        class="cf-demo__toggle"
        type="button"
        aria-expanded="false"
        data-demo-toggle
      >
        <svg class="cf-demo__toggle-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="cf-demo__toggle-label">查看代码</span>
      </button>

      <div class="cf-demo__code-body cf-doc-code" data-doc-code-tone="light">
        {codeLayout === 'workspace' ? (
          <DocCodeWorkspace files={codeTabs} title="Demo source" rootLabel="demo" />
        ) : (
          <>
            <div class="cf-demo__code-bar">
              <div class="cf-demo__tabs" role="tablist" aria-label="Demo source">
                {codeTabs.map((tab, index) => (
                  <button
                    type="button"
                    class="cf-demo__tab"
                    data-demo-tab={tab.id}
                    aria-selected={index === 0 ? 'true' : 'false'}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>
              <div class="cf-demo__code-tools" aria-label="代码主题">
                <button
                  type="button"
                  class="cf-demo__code-tone"
                  data-demo-code-tone="light"
                  aria-pressed="true"
                >
                  浅色
                </button>
                <button
                  type="button"
                  class="cf-demo__code-tone"
                  data-demo-code-tone="dark"
                  aria-pressed="false"
                >
                  深色
                </button>
              </div>
            </div>
            {codeTabs.map((tab, index) => (
              <div
                class="cf-demo__panel"
                data-demo-panel={tab.id}
                data-active={index === 0 ? 'true' : 'false'}
              >
                <div class="cf-demo__code">
                  <button
                    class="cf-demo__copy"
                    type="button"
                    data-demo-copy
                    data-copy={tab.content}
                    data-copy-label="复制"
                    data-copied-label="已复制"
                  >
                    复制
                  </button>
                  <Code
                    code={tab.content}
                    lang={tab.lang}
                    themes={{ light: 'github-light', dark: 'github-dark' }}
                    defaultColor="light"
                  />
                </div>
              </div>
            ))}
          </>
        )}
      </div>
    </div>
  )}
</div>

<script>
  function bind(root: HTMLElement) {
    if (root.dataset.demoBound === 'true') return;
    root.dataset.demoBound = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-demo-toggle]');
    const section = root.querySelector<HTMLElement>('.cf-demo__code-section');
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-demo-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-demo-panel]');
    const bgBtns = root.querySelectorAll<HTMLButtonElement>('[data-demo-bg]');
    const toneBtns = root.querySelectorAll<HTMLButtonElement>('[data-demo-code-tone]');
    const codeBody = root.querySelector<HTMLElement>('.cf-demo__code-body');
    const preview = root.querySelector<HTMLElement>('.cf-demo__preview');
    const floatingSelector = [
      '.cf-select.is-open',
      '.cf-combobox.is-open',
      '.cf-date.is-open',
      '.cf-color.is-open',
      '.cf-navmenu__item.is-open',
    ].join(',');

    const syncFloatingState = () => {
      root.dataset.floatingOpen = String(Boolean(root.querySelector(floatingSelector)));
    };

    if (toggle && section) {
      toggle.addEventListener('click', () => {
        const collapsed = section.dataset.collapsed === 'true';
        section.dataset.collapsed = String(!collapsed);
        toggle.setAttribute('aria-expanded', String(collapsed));
        const label = toggle.querySelector<HTMLElement>('.cf-demo__toggle-label');
        if (label) label.textContent = collapsed ? '收起代码' : '查看代码';
        syncFloatingState();
      });
    }

    const activate = (id: string) => {
      tabBtns.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset.demoTab === id)));
      panels.forEach((panel) => (panel.dataset.active = String(panel.dataset.demoPanel === id)));
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => activate(btn.dataset.demoTab ?? ''));
    });

    bgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const bg = btn.dataset.demoBg ?? 'transparent';
        if (preview) preview.dataset.demoBg = bg;
        bgBtns.forEach((item) => {
          const active = item === btn;
          item.dataset.active = String(active);
          item.setAttribute('aria-pressed', String(active));
        });
      });
      btn.setAttribute('aria-pressed', String(btn.dataset.active === 'true'));
    });

    toneBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tone = btn.dataset.demoCodeTone ?? 'light';
        if (codeBody) codeBody.dataset.docCodeTone = tone;
        toneBtns.forEach((item) => item.setAttribute('aria-pressed', String(item === btn)));
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-demo-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* clipboard blocked */
        }
        const label = btn.dataset.copyLabel ?? '复制';
        btn.textContent = btn.dataset.copiedLabel ?? '已复制';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = label;
          btn.dataset.copied = 'false';
        }, 1400);
      });
    });

    const observer = new MutationObserver(syncFloatingState);
    observer.observe(root, {
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'data-state', 'aria-expanded'],
    });
    syncFloatingState();
  }
  document
    .querySelectorAll<HTMLElement>('[data-demo-frame]')
    .forEach((el) => bind(el));
</script>
