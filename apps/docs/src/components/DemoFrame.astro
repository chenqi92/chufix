---
import { Code } from 'astro:components';

interface Props {
  vueCode?: string;
  reactCode?: string;
  cliCode?: string;
}
const { vueCode, reactCode, cliCode } = Astro.props;
const hasVueSlot = Astro.slots.has('vue');
const hasReactSlot = Astro.slots.has('react');

const codeTabs: Array<{ key: 'vue' | 'react' | 'cli'; label: string; code: string; lang: string }> = [];
if (vueCode) codeTabs.push({ key: 'vue', label: 'Vue', code: vueCode, lang: 'vue' });
if (reactCode) codeTabs.push({ key: 'react', label: 'React', code: reactCode, lang: 'tsx' });
if (cliCode) codeTabs.push({ key: 'cli', label: 'CLI', code: cliCode, lang: 'bash' });
---

<div class="ck-demo" data-demo-frame>
  <div class="ck-demo__preview">
    {hasVueSlot && (
      <section class="ck-demo__pane">
        <span class="ck-demo__fw ck-demo__fw--vue">
          <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><path fill="currentColor" d="M2 4l10 16L22 4h-4l-6 9.6L6 4z"/></svg>
          Vue
        </span>
        <div class="ck-demo__pane-content">
          <slot name="vue" />
        </div>
      </section>
    )}
    {hasVueSlot && hasReactSlot && <div class="ck-demo__divider" aria-hidden="true" />}
    {hasReactSlot && (
      <section class="ck-demo__pane">
        <span class="ck-demo__fw ck-demo__fw--react">
          <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true"><circle cx="12" cy="12" r="2" fill="currentColor"/><g fill="none" stroke="currentColor" stroke-width="1.4"><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/></g></svg>
          React
        </span>
        <div class="ck-demo__pane-content">
          <slot name="react" />
        </div>
      </section>
    )}
    {!hasVueSlot && !hasReactSlot && (
      <div class="ck-demo__pane-content ck-demo__pane-content--solo">
        <slot />
      </div>
    )}
  </div>

  {codeTabs.length > 0 && (
    <div class="ck-demo__code-section">
      <div class="ck-demo__code-bar">
        <span class="ck-demo__code-label">代码</span>
        <div class="ck-demo__tabs" role="tablist">
          {codeTabs.map((t, i) => (
            <button
              class="ck-demo__tab"
              role="tab"
              data-target={t.key}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {t.label}
            </button>
          ))}
        </div>
      </div>
      {codeTabs.map((t, i) => (
        <div class="ck-demo__panel" data-panel={t.key} data-active={i === 0 ? 'true' : 'false'}>
          <div class="ck-demo__code">
            <button class="ck-demo__copy" data-copy={t.code}>复制</button>
            <Code code={t.code} lang={t.lang as any} theme="github-dark" />
          </div>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  function bind(root: HTMLElement) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.ck-demo__tab');
    const panels = root.querySelectorAll<HTMLElement>('.ck-demo__panel');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.dataset.active = String(p.dataset.panel === target);
        });
      });
    });
    root.querySelectorAll<HTMLButtonElement>('.ck-demo__copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* clipboard blocked — ignore */
        }
        const original = btn.textContent;
        btn.dataset.copied = 'true';
        btn.textContent = '已复制';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          btn.textContent = original;
        }, 1400);
      });
    });
  }
  document
    .querySelectorAll<HTMLElement>('[data-demo-frame]')
    .forEach((el) => bind(el));
</script>
