---
import { Code } from 'astro:components';
import DocCodeWorkspace from './DocCodeWorkspace.astro';

interface Props {
  vueCode?: string;
  reactCode?: string;
  cliCode?: string;
  variant?: 'default' | 'wide' | 'compact';
  codeLayout?: 'tabs' | 'workspace';
}
type DocCodeFile = {
  id: string;
  label: string;
  name: string;
  content: string;
  lang: 'vue' | 'tsx' | 'bash';
};
const { vueCode, reactCode, cliCode, variant = 'default', codeLayout = 'tabs' } = Astro.props;

const codeTabs: DocCodeFile[] = [];
if (vueCode) codeTabs.push({ id: 'vue', label: 'Vue', name: 'src/App.vue', content: vueCode, lang: 'vue' });
if (reactCode) codeTabs.push({ id: 'react', label: 'React', name: 'src/App.tsx', content: reactCode, lang: 'tsx' });
if (cliCode) codeTabs.push({ id: 'cli', label: 'CLI', name: 'scripts/setup.sh', content: cliCode, lang: 'bash' });
---

<div class:list={['cf-demo', variant !== 'default' && `cf-demo--${variant}`]} data-demo-frame>
  <div class="cf-demo__preview">
    <div class="cf-demo__pane-content">
      <slot />
    </div>
  </div>

  {codeTabs.length > 0 && (
    <div class="cf-demo__code-section" data-collapsed="true">
      <button
        class="cf-demo__toggle"
        type="button"
        aria-expanded="false"
        data-demo-toggle
      >
        <svg class="cf-demo__toggle-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="cf-demo__toggle-label">查看代码</span>
      </button>

      <div class="cf-demo__code-body">
        {codeLayout === 'workspace' ? (
          <DocCodeWorkspace files={codeTabs} title="Demo source" rootLabel="demo" />
        ) : (
          <>
            <div class="cf-demo__code-bar">
              <div class="cf-demo__tabs" role="tablist" aria-label="Demo source">
                {codeTabs.map((tab, index) => (
                  <button
                    type="button"
                    class="cf-demo__tab"
                    data-demo-tab={tab.id}
                    aria-selected={index === 0 ? 'true' : 'false'}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>
            </div>
            {codeTabs.map((tab, index) => (
              <div
                class="cf-demo__panel"
                data-demo-panel={tab.id}
                data-active={index === 0 ? 'true' : 'false'}
              >
                <div class="cf-demo__code">
                  <button
                    class="cf-demo__copy"
                    type="button"
                    data-demo-copy
                    data-copy={tab.content}
                    data-copy-label="复制"
                    data-copied-label="已复制"
                  >
                    复制
                  </button>
                  <Code code={tab.content} lang={tab.lang} theme="github-dark" />
                </div>
              </div>
            ))}
          </>
        )}
      </div>
    </div>
  )}
</div>

<script>
  function bind(root: HTMLElement) {
    if (root.dataset.demoBound === 'true') return;
    root.dataset.demoBound = 'true';

    const toggle = root.querySelector<HTMLButtonElement>('[data-demo-toggle]');
    const section = root.querySelector<HTMLElement>('.cf-demo__code-section');
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-demo-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-demo-panel]');
    const floatingSelector = [
      '.cf-select.is-open',
      '.cf-combobox.is-open',
      '.cf-date.is-open',
      '.cf-color.is-open',
      '.cf-navmenu__item.is-open',
    ].join(',');

    const syncFloatingState = () => {
      root.dataset.floatingOpen = String(Boolean(root.querySelector(floatingSelector)));
    };

    if (toggle && section) {
      toggle.addEventListener('click', () => {
        const collapsed = section.dataset.collapsed === 'true';
        section.dataset.collapsed = String(!collapsed);
        toggle.setAttribute('aria-expanded', String(collapsed));
        const label = toggle.querySelector<HTMLElement>('.cf-demo__toggle-label');
        if (label) label.textContent = collapsed ? '收起代码' : '查看代码';
        syncFloatingState();
      });
    }

    const activate = (id: string) => {
      tabBtns.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset.demoTab === id)));
      panels.forEach((panel) => (panel.dataset.active = String(panel.dataset.demoPanel === id)));
    };

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => activate(btn.dataset.demoTab ?? ''));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-demo-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* clipboard blocked */
        }
        const label = btn.dataset.copyLabel ?? '复制';
        btn.textContent = btn.dataset.copiedLabel ?? '已复制';
        btn.dataset.copied = 'true';
        setTimeout(() => {
          btn.textContent = label;
          btn.dataset.copied = 'false';
        }, 1400);
      });
    });

    const observer = new MutationObserver(syncFloatingState);
    observer.observe(root, {
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'data-state', 'aria-expanded'],
    });
    syncFloatingState();
  }
  document
    .querySelectorAll<HTMLElement>('[data-demo-frame]')
    .forEach((el) => bind(el));
</script>
