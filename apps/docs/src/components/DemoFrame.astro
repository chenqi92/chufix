---
import { Code } from 'astro:components';

interface Props {
  vueCode?: string;
  reactCode?: string;
  cliCode?: string;
}
const { vueCode, reactCode, cliCode } = Astro.props;

const codeTabs: Array<{ key: 'vue' | 'react' | 'cli'; label: string; code: string; lang: string }> = [];
if (vueCode) codeTabs.push({ key: 'vue', label: 'Vue', code: vueCode, lang: 'vue' });
if (reactCode) codeTabs.push({ key: 'react', label: 'React', code: reactCode, lang: 'tsx' });
if (cliCode) codeTabs.push({ key: 'cli', label: 'CLI', code: cliCode, lang: 'bash' });
---

<div class="ck-demo" data-demo-frame>
  <div class="ck-demo__preview">
    <div class="ck-demo__pane-content">
      <slot />
    </div>
  </div>

  {codeTabs.length > 0 && (
    <div class="ck-demo__code-section" data-collapsed="true">
      <button
        class="ck-demo__toggle"
        type="button"
        aria-expanded="false"
        data-demo-toggle
      >
        <svg class="ck-demo__toggle-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="ck-demo__toggle-label">查看代码</span>
      </button>

      <div class="ck-demo__code-body">
        <div class="ck-demo__code-bar">
          <div class="ck-demo__tabs" role="tablist">
            {codeTabs.map((t, i) => (
              <button
                class="ck-demo__tab"
                role="tab"
                data-target={t.key}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                {t.label}
              </button>
            ))}
          </div>
        </div>
        {codeTabs.map((t, i) => (
          <div class="ck-demo__panel" data-panel={t.key} data-active={i === 0 ? 'true' : 'false'}>
            <div class="ck-demo__code">
              <button class="ck-demo__copy" data-copy={t.code}>复制</button>
              <Code code={t.code} lang={t.lang as any} theme="github-dark" />
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</div>

<script>
  function bind(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-demo-toggle]');
    const section = root.querySelector<HTMLElement>('.ck-demo__code-section');
    const tabs = root.querySelectorAll<HTMLButtonElement>('.ck-demo__tab');
    const panels = root.querySelectorAll<HTMLElement>('.ck-demo__panel');

    if (toggle && section) {
      toggle.addEventListener('click', () => {
        const collapsed = section.dataset.collapsed === 'true';
        section.dataset.collapsed = String(!collapsed);
        toggle.setAttribute('aria-expanded', String(collapsed));
        const label = toggle.querySelector<HTMLElement>('.ck-demo__toggle-label');
        if (label) label.textContent = collapsed ? '收起代码' : '查看代码';
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.target;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.dataset.active = String(p.dataset.panel === target);
        });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.ck-demo__copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* clipboard blocked — ignore */
        }
        const original = btn.textContent;
        btn.dataset.copied = 'true';
        btn.textContent = '已复制';
        setTimeout(() => {
          btn.dataset.copied = 'false';
          btn.textContent = original;
        }, 1400);
      });
    });
  }
  document
    .querySelectorAll<HTMLElement>('[data-demo-frame]')
    .forEach((el) => bind(el));
</script>
