---
import { Code } from 'astro:components';
import type { WorkspaceBundle, DocCodeLang } from './docCode';
import { normalizeCode } from './docCode';

interface TreeItem {
  id: string;
  kind: 'folder' | 'file';
  name: string;
  path: string;
  depth: number;
  fileId?: string;
}

interface RenderableFile {
  bundleId: string;
  fileId: string;
  name: string;
  content: string;
  lang: DocCodeLang;
}

interface Props {
  bundles: WorkspaceBundle[];
  title?: string;
  rootLabel?: string;
  height?: number | string;
  showLineNumbers?: boolean;
}

const {
  bundles,
  title = 'Source',
  rootLabel = 'project',
  height = 'min(560px, 68vh)',
  showLineNumbers = true,
} = Astro.props;

const heightValue = typeof height === 'number' ? `${height}px` : height;

const normalizedBundles = bundles.map((bundle) => ({
  ...bundle,
  files: bundle.files.map((file) => ({
    ...file,
    content: normalizeCode(file.content),
  })),
}));

const fileName = (path: string) => path.split('/').filter(Boolean).at(-1) ?? path;

type FileKind = 'vue' | 'tsx' | 'jsx' | 'ts' | 'js' | 'css' | 'json' | 'html' | 'md' | 'default';
function fileKind(name: string): FileKind {
  const ext = name.split('.').pop()?.toLowerCase() ?? '';
  if (ext === 'vue') return 'vue';
  if (ext === 'tsx') return 'tsx';
  if (ext === 'jsx') return 'jsx';
  if (ext === 'ts') return 'ts';
  if (ext === 'js' || ext === 'mjs' || ext === 'cjs') return 'js';
  if (ext === 'css') return 'css';
  if (ext === 'json') return 'json';
  if (ext === 'html') return 'html';
  if (ext === 'md' || ext === 'mdx') return 'md';
  return 'default';
}

function buildTree(bundleId: string, files: WorkspaceBundle['files']): TreeItem[] {
  const rows: TreeItem[] = [];
  const seen = new Set<string>();
  for (const file of files) {
    const parts = file.name.split('/').filter(Boolean);
    let path = '';
    for (let i = 0; i < parts.length - 1; i++) {
      path = path ? `${path}/${parts[i]}` : parts[i]!;
      if (seen.has(`${bundleId}::${path}`)) continue;
      seen.add(`${bundleId}::${path}`);
      rows.push({
        id: `folder:${bundleId}:${path}`,
        kind: 'folder',
        name: parts[i]!,
        path,
        depth: i,
      });
    }
    rows.push({
      id: `file:${bundleId}:${file.name}`,
      kind: 'file',
      name: fileName(file.name),
      path: file.name,
      depth: Math.max(0, parts.length - 1),
      fileId: `${bundleId}::${file.name}`,
    });
  }
  return rows;
}

const trees = normalizedBundles.map((bundle) => ({
  bundle,
  rows: buildTree(bundle.id, bundle.files),
}));

const renderable: RenderableFile[] = normalizedBundles.flatMap((bundle) =>
  bundle.files.map((file) => ({
    bundleId: bundle.id,
    fileId: `${bundle.id}::${file.name}`,
    name: file.name,
    content: file.content,
    lang: file.lang,
  })),
);

const defaultBundleId = normalizedBundles[0]?.id ?? '';
const defaultFramework = normalizedBundles[0]?.framework ?? 'neutral';
const defaultFileId = normalizedBundles[0]?.files[0]
  ? `${normalizedBundles[0].id}::${normalizedBundles[0].files[0].name}`
  : '';
const defaultCopy = normalizedBundles[0]?.files[0]?.content ?? '';

// Framework tabs: distinct frameworks across bundles, in declaration order.
const frameworkOrder: string[] = [];
for (const bundle of normalizedBundles) {
  if (bundle.framework === 'neutral') continue;
  if (!frameworkOrder.includes(bundle.framework)) frameworkOrder.push(bundle.framework);
}
const frameworkLabel: Record<string, string> = {};
for (const bundle of normalizedBundles) {
  if (bundle.framework === 'neutral') continue;
  frameworkLabel[bundle.framework] ??= bundle.frameworkLabel;
}
const showFrameworkTabs = frameworkOrder.length > 1;
const showVariantTabs = normalizedBundles.some(
  (bundle) => bundle.framework !== 'neutral',
) && normalizedBundles.some((bundle) => {
  if (bundle.framework === 'neutral') return false;
  return normalizedBundles.some(
    (other) =>
      other !== bundle &&
      other.framework === bundle.framework &&
      other.variant !== bundle.variant,
  );
});
---

<div
  class:list={[
    'cf-code-workspace',
    'cf-code-workspace--md',
    showLineNumbers && 'has-numbers',
    'cf-doc-code',
  ]}
  data-doc-code-workspace
  data-active-bundle={defaultBundleId}
  data-active-framework={defaultFramework}
  style={`height: ${heightValue};`}
>
  <header class="cf-code-workspace__header">
    <div class="cf-code-workspace__title">
      <span class="cf-code-workspace__traffic" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>{title}</span>
    </div>
    <div class="cf-code-workspace__actions">
      <button
        type="button"
        class="cf-code-workspace__copy"
        data-doc-code-copy
        data-copy={defaultCopy}
        data-copy-label="复制"
        data-copied-label="已复制"
      >
        复制
      </button>
    </div>
  </header>

  {(showFrameworkTabs || showVariantTabs) && (
    <div class="cf-code-workspace__bundles" role="tablist" aria-label="Framework">
      {showFrameworkTabs && (
        <div class="cf-code-workspace__frameworks">
          {frameworkOrder.map((framework) => (
            <button
              type="button"
              class="cf-code-workspace__framework-tab"
              data-doc-code-framework={framework}
              aria-selected={normalizedBundles[0]?.framework === framework ? 'true' : 'false'}
            >
              {frameworkLabel[framework]}
            </button>
          ))}
        </div>
      )}
      {showVariantTabs && (
        <div class="cf-code-workspace__variants">
          {normalizedBundles.map((bundle) => bundle.framework !== 'neutral' && (
            <button
              type="button"
              class="cf-code-workspace__variant-tab"
              data-doc-code-bundle={bundle.id}
              data-doc-code-bundle-framework={bundle.framework}
              aria-selected={bundle.id === defaultBundleId ? 'true' : 'false'}
            >
              {bundle.variantLabel}
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <div class="cf-code-workspace__shell">
    <aside class="cf-code-workspace__tree" aria-label="Code files">
      <div class="cf-code-workspace__root">
        <span class="cf-code-workspace__folder-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 4.5 A1 1 0 0 1 3 3.5 H6 L7.5 5 H13 A1 1 0 0 1 14 6 V11.5 A1 1 0 0 1 13 12.5 H3 A1 1 0 0 1 2 11.5 Z" />
          </svg>
        </span>
        <span>{rootLabel}</span>
      </div>
      {trees.map(({ bundle, rows }) => (
        <div
          class="cf-code-workspace__tree-bundle"
          data-doc-code-tree={bundle.id}
          data-active={bundle.id === defaultBundleId ? 'true' : 'false'}
        >
          {rows.map((item) =>
            item.kind === 'folder' ? (
              <div
                class="cf-code-workspace__folder"
                style={`--cf-code-tree-indent: ${item.depth * 14}px;`}
              >
                <span class="cf-code-workspace__folder-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4.5 A1 1 0 0 1 3 3.5 H6 L7.5 5 H13 A1 1 0 0 1 14 6 V11.5 A1 1 0 0 1 13 12.5 H3 A1 1 0 0 1 2 11.5 Z" />
                  </svg>
                </span>
                <span>{item.name}</span>
              </div>
            ) : (
              <button
                type="button"
                class={`cf-code-workspace__file cf-code-workspace__file--${fileKind(item.name)}`}
                style={`--cf-code-tree-indent: ${item.depth * 14}px;`}
                data-doc-code-file={item.fileId}
                data-doc-code-file-bundle={bundle.id}
                aria-selected={item.fileId === defaultFileId ? 'true' : 'false'}
              >
                <span class="cf-code-workspace__file-icon" aria-hidden="true">
                  {fileKind(item.name) === 'vue' && (
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2 2 L8 14 L14 2 L11.5 2 L8 8.5 L4.5 2 Z"/></svg>
                  )}
                  {(fileKind(item.name) === 'tsx' || fileKind(item.name) === 'ts') && (
                    <span class="cf-code-workspace__file-glyph">TS</span>
                  )}
                  {(fileKind(item.name) === 'jsx' || fileKind(item.name) === 'js') && (
                    <span class="cf-code-workspace__file-glyph">JS</span>
                  )}
                  {fileKind(item.name) === 'css' && (
                    <span class="cf-code-workspace__file-glyph">#</span>
                  )}
                  {fileKind(item.name) === 'json' && (
                    <span class="cf-code-workspace__file-glyph">{'{}'}</span>
                  )}
                  {fileKind(item.name) === 'html' && (
                    <span class="cf-code-workspace__file-glyph">&lt;&gt;</span>
                  )}
                  {fileKind(item.name) === 'md' && (
                    <span class="cf-code-workspace__file-glyph">M</span>
                  )}
                  {fileKind(item.name) === 'default' && (
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2.5 H10 L13 5.5 V13.5 H4 Z"/><path d="M10 2.5 V5.5 H13"/></svg>
                  )}
                </span>
                <span class="cf-code-workspace__file-name">{item.name}</span>
              </button>
            )
          )}
        </div>
      ))}
    </aside>

    <section class="cf-code-workspace__editor" aria-live="polite">
      <div class="cf-code-workspace__tabs" role="tablist">
        {normalizedBundles.map((bundle) => (
          <div
            class="cf-code-workspace__tabs-bundle"
            data-doc-code-tabs={bundle.id}
            data-active={bundle.id === defaultBundleId ? 'true' : 'false'}
          >
            {bundle.files.map((file, index) => {
              const fileId = `${bundle.id}::${file.name}`;
              return (
                <div
                  class="cf-code-workspace__tab"
                  data-doc-code-tab-item={fileId}
                  data-doc-code-tab-item-bundle={bundle.id}
                  data-open="true"
                  aria-selected={index === 0 ? 'true' : 'false'}
                >
                  <button
                    type="button"
                    class="cf-code-workspace__tab-trigger"
                    data-doc-code-tab={fileId}
                    data-doc-code-tab-bundle={bundle.id}
                    data-open="true"
                  >
                    {fileName(file.name)}
                  </button>
                  <button
                    type="button"
                    class="cf-code-workspace__tab-close"
                    data-doc-code-tab-close={fileId}
                    data-doc-code-tab-close-bundle={bundle.id}
                    aria-label={`关闭 ${fileName(file.name)}`}
                  >
                    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                      <path d="M3.25 3.25L8.75 8.75M8.75 3.25L3.25 8.75" />
                    </svg>
                  </button>
                </div>
              );
            })}
          </div>
        ))}
      </div>

      {renderable.map((file, index) => (
        <div
          class="cf-doc-code__panel"
          data-doc-code-panel={file.fileId}
          data-doc-code-panel-bundle={file.bundleId}
          data-open="true"
          data-active={file.fileId === defaultFileId ? 'true' : 'false'}
        >
          <div class="cf-code-workspace__meta">
            <span>{file.name}</span>
            <span class="cf-code-workspace__lang">{file.lang}</span>
          </div>
          <div class="cf-code-workspace__body">
            <div class="cf-doc-code__scroll">
              <Code
                code={file.content}
                lang={file.lang as any}
                themes={{ light: 'github-light', dark: 'github-dark' }}
                defaultColor="light"
              />
            </div>
          </div>
        </div>
      ))}
    </section>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-doc-code-workspace]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const frameworkBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-framework]');
    const variantBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-bundle]');
    const trees = root.querySelectorAll<HTMLElement>('[data-doc-code-tree]');
    const fileBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-file]');
    const tabGroups = root.querySelectorAll<HTMLElement>('[data-doc-code-tabs]');
    const tabItems = root.querySelectorAll<HTMLElement>('[data-doc-code-tab-item]');
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-tab]');
    const tabCloseBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-tab-close]');
    const panels = root.querySelectorAll<HTMLElement>('[data-doc-code-panel]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-doc-code-copy]');

    const syncCopyTarget = () => {
      if (!copyBtn) return;
      const activePanel = Array.from(panels).find((panel) => panel.dataset.active === 'true');
      if (!activePanel) return;
      copyBtn.dataset.copy = activePanel.querySelector('pre')?.textContent ?? '';
    };

    const firstFileIdOfBundle = (bundleId: string) => {
      const firstTab = root.querySelector<HTMLElement>(
        `[data-doc-code-tab-item-bundle="${bundleId}"][data-open="true"]`,
      );
      return firstTab?.dataset.docCodeTabItem
        ?? root.querySelector<HTMLElement>(`[data-doc-code-tab-item-bundle="${bundleId}"]`)
          ?.dataset.docCodeTabItem
        ?? '';
    };

    const firstBundleOfFramework = (framework: string) => {
      const first = root.querySelector<HTMLButtonElement>(
        `[data-doc-code-bundle-framework="${framework}"]`,
      );
      return first?.dataset.docCodeBundle ?? '';
    };

    const activateBundle = (bundleId: string) => {
      if (!bundleId) return;
      root.dataset.activeBundle = bundleId;
      variantBtns.forEach((btn) =>
        btn.setAttribute('aria-selected', String(btn.dataset.docCodeBundle === bundleId)),
      );
      trees.forEach((tree) => (tree.dataset.active = String(tree.dataset.docCodeTree === bundleId)));
      tabGroups.forEach(
        (group) => (group.dataset.active = String(group.dataset.docCodeTabs === bundleId)),
      );
      const bundleFramework = root
        .querySelector<HTMLButtonElement>(`[data-doc-code-bundle="${bundleId}"]`)
        ?.dataset.docCodeBundleFramework;
      if (bundleFramework) {
        root.dataset.activeFramework = bundleFramework;
        frameworkBtns.forEach((btn) =>
          btn.setAttribute(
            'aria-selected',
            String(btn.dataset.docCodeFramework === bundleFramework),
          ),
        );
      }
      activateFile(firstFileIdOfBundle(bundleId));
    };

    const activateFile = (fileId: string) => {
      if (!fileId) return;
      const targetTab = root.querySelector<HTMLElement>(`[data-doc-code-tab-item="${fileId}"]`);
      const targetPanel = root.querySelector<HTMLElement>(`[data-doc-code-panel="${fileId}"]`);
      if (targetTab) targetTab.dataset.open = 'true';
      if (targetPanel) targetPanel.dataset.open = 'true';
      fileBtns.forEach((btn) =>
        btn.setAttribute('aria-selected', String(btn.dataset.docCodeFile === fileId)),
      );
      tabItems.forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab.dataset.docCodeTabItem === fileId));
      });
      panels.forEach((panel) => {
        panel.dataset.active = String(panel.dataset.docCodePanel === fileId);
      });
      syncCopyTarget();
    };

    const closeFile = (fileId: string) => {
      if (!fileId) return;
      const tab = root.querySelector<HTMLElement>(`[data-doc-code-tab-item="${fileId}"]`);
      const panel = root.querySelector<HTMLElement>(`[data-doc-code-panel="${fileId}"]`);
      const isActive = panel?.dataset.active === 'true';
      if (tab) {
        tab.dataset.open = 'false';
        tab.setAttribute('aria-selected', 'false');
      }
      if (panel) {
        panel.dataset.open = 'false';
        panel.dataset.active = 'false';
      }
      if (!isActive) return;

      const bundleId = panel?.dataset.docCodePanelBundle ?? root.dataset.activeBundle ?? '';
      const openTabs = Array.from(
        root.querySelectorAll<HTMLElement>(
          `[data-doc-code-tab-item-bundle="${bundleId}"][data-open="true"]`,
        ),
      );
      const nextId = openTabs[0]?.dataset.docCodeTabItem ?? '';
      if (nextId) {
        activateFile(nextId);
        return;
      }
      fileBtns.forEach((btn) => btn.setAttribute('aria-selected', 'false'));
      syncCopyTarget();
    };

    frameworkBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const target = firstBundleOfFramework(btn.dataset.docCodeFramework ?? '');
        if (target) activateBundle(target);
      }),
    );

    variantBtns.forEach((btn) =>
      btn.addEventListener('click', () => activateBundle(btn.dataset.docCodeBundle ?? '')),
    );

    fileBtns.forEach((btn) =>
      btn.addEventListener('click', () => activateFile(btn.dataset.docCodeFile ?? '')),
    );

    tabBtns.forEach((btn) =>
      btn.addEventListener('click', () => activateFile(btn.dataset.docCodeTab ?? '')),
    );

    tabCloseBtns.forEach((btn) =>
      btn.addEventListener('click', () => closeFile(btn.dataset.docCodeTabClose ?? '')),
    );

    copyBtn?.addEventListener('click', async () => {
      const text = copyBtn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        /* clipboard blocked */
      }
      const label = copyBtn.dataset.copyLabel ?? '复制';
      copyBtn.textContent = copyBtn.dataset.copiedLabel ?? '已复制';
      setTimeout(() => {
        copyBtn.textContent = label;
      }, 1400);
    });

    syncCopyTarget();
  });
</script>
