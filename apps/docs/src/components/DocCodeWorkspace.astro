---
import { Code } from 'astro:components';

export interface DocCodeFile {
  id?: string;
  name: string;
  content: string;
  lang: 'vue' | 'tsx' | 'jsx' | 'ts' | 'js' | 'json' | 'css' | 'bash' | 'mdx' | 'astro' | 'html';
}

interface TreeItem {
  id: string;
  kind: 'folder' | 'file';
  name: string;
  path: string;
  depth: number;
  file?: DocCodeFile;
}

interface Props {
  files: DocCodeFile[];
  title?: string;
  rootLabel?: string;
  height?: number | string;
  tone?: 'light' | 'dark';
  showLineNumbers?: boolean;
}

const {
  files,
  title = 'Source',
  rootLabel = 'project',
  height = 'min(560px, 68vh)',
  tone = 'light',
  showLineNumbers = true,
} = Astro.props;

const normalizedFiles = files.map((file) => ({
  ...file,
  content: normalizeCode(file.content),
}));
const heightValue = typeof height === 'number' ? `${height}px` : height;
const fileId = (file: DocCodeFile) => file.id ?? file.name;
const fileName = (path: string) => path.split('/').filter(Boolean).at(-1) ?? path;

function normalizeCode(value?: string) {
  return String(value || '')
    .replace(/\r\n?/g, '\n')
    .trim()
    .replace(/[ \t]+\n/g, '\n')
    .replace(/\n{3,}/g, '\n\n');
}

function buildTree(source: DocCodeFile[]): TreeItem[] {
  const rows: TreeItem[] = [];
  const seen = new Set<string>();
  for (const file of source) {
    const parts = file.name.split('/').filter(Boolean);
    let path = '';
    for (let i = 0; i < parts.length - 1; i++) {
      path = path ? `${path}/${parts[i]}` : parts[i]!;
      if (!seen.has(path)) {
        seen.add(path);
        rows.push({
          id: `folder:${path}`,
          kind: 'folder',
          name: parts[i]!,
          path,
          depth: i,
        });
      }
    }
    rows.push({
      id: `file:${fileId(file)}`,
      kind: 'file',
      name: fileName(file.name),
      path: file.name,
      depth: Math.max(0, parts.length - 1),
      file,
    });
  }
  return rows;
}

const tree = buildTree(normalizedFiles);
---

<div
  class:list={[
    'cf-code-workspace',
    `cf-code-workspace--${tone}`,
    'cf-code-workspace--md',
    showLineNumbers && 'has-numbers',
    'cf-doc-code',
  ]}
  data-doc-code-workspace
  data-doc-code-tone={tone}
  style={`height: ${heightValue};`}
>
  <header class="cf-code-workspace__header">
    <div class="cf-code-workspace__title">
      <span class="cf-code-workspace__traffic" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>{title}</span>
    </div>
    <div class="cf-code-workspace__actions">
      <div class="cf-demo__code-tools" aria-label="代码主题">
        <button
          type="button"
          class="cf-demo__code-tone"
          data-doc-code-tone-button="light"
          aria-pressed={tone === 'light' ? 'true' : 'false'}
        >
          浅色
        </button>
        <button
          type="button"
          class="cf-demo__code-tone"
          data-doc-code-tone-button="dark"
          aria-pressed={tone === 'dark' ? 'true' : 'false'}
        >
          深色
        </button>
      </div>
      {normalizedFiles[0] && (
        <button
          type="button"
          class="cf-code-workspace__copy"
          data-doc-code-copy
          data-copy={normalizedFiles[0].content}
          data-copy-label="复制"
          data-copied-label="已复制"
        >
          复制
        </button>
      )}
    </div>
  </header>

  <div class="cf-code-workspace__shell">
    <aside class="cf-code-workspace__tree" aria-label="Code files">
      <div class="cf-code-workspace__root">
        <span class="cf-code-workspace__folder-icon" aria-hidden="true"></span>
        <span>{rootLabel}</span>
      </div>
      {tree.map((item) =>
        item.kind === 'folder' ? (
          <div
            class="cf-code-workspace__folder"
            style={`--cf-code-tree-indent: ${item.depth * 14}px;`}
          >
            <span class="cf-code-workspace__folder-icon" aria-hidden="true"></span>
            <span>{item.name}</span>
          </div>
        ) : (
          <button
            type="button"
            class="cf-code-workspace__file"
            style={`--cf-code-tree-indent: ${item.depth * 14}px;`}
            data-doc-code-file={item.file ? fileId(item.file) : ''}
            aria-selected={item.file && fileId(item.file) === fileId(normalizedFiles[0]) ? 'true' : 'false'}
          >
            <span class="cf-code-workspace__file-dot" aria-hidden="true"></span>
            <span class="cf-code-workspace__file-name">{item.name}</span>
          </button>
        )
      )}
    </aside>

    <section class="cf-code-workspace__editor" aria-live="polite">
      <div class="cf-code-workspace__tabs" role="tablist">
        {normalizedFiles.map((file, index) => (
          <button
            type="button"
            class="cf-code-workspace__tab"
            data-doc-code-tab={fileId(file)}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            {fileName(file.name)}
          </button>
        ))}
      </div>

      {normalizedFiles.map((file, index) => (
        <div
          class="cf-doc-code__panel"
          data-doc-code-panel={fileId(file)}
          data-active={index === 0 ? 'true' : 'false'}
        >
          <div class="cf-code-workspace__meta">
            <span>{file.name}</span>
            <span class="cf-code-workspace__lang">{file.lang}</span>
          </div>
          <div class="cf-code-workspace__body">
            <div class="cf-doc-code__scroll">
              <Code
                code={file.content}
                lang={file.lang as any}
                themes={{ light: 'github-light', dark: 'github-dark' }}
                defaultColor="light"
              />
            </div>
          </div>
        </div>
      ))}
    </section>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-doc-code-workspace]').forEach((root) => {
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const fileBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-file]');
    const tabBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-doc-code-panel]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-doc-code-copy]');
    const toneBtns = root.querySelectorAll<HTMLButtonElement>('[data-doc-code-tone-button]');

    const activate = (id: string) => {
      fileBtns.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset.docCodeFile === id)));
      tabBtns.forEach((btn) => btn.setAttribute('aria-selected', String(btn.dataset.docCodeTab === id)));
      panels.forEach((panel) => {
        const active = panel.dataset.docCodePanel === id;
        panel.dataset.active = String(active);
        if (active && copyBtn) copyBtn.dataset.copy = panel.querySelector('pre')?.textContent ?? '';
      });
    };

    fileBtns.forEach((btn) => btn.addEventListener('click', () => activate(btn.dataset.docCodeFile ?? '')));
    tabBtns.forEach((btn) => btn.addEventListener('click', () => activate(btn.dataset.docCodeTab ?? '')));

    toneBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tone = btn.dataset.docCodeToneButton ?? 'light';
        root.dataset.docCodeTone = tone;
        root.classList.toggle('cf-code-workspace--light', tone === 'light');
        root.classList.toggle('cf-code-workspace--dark', tone === 'dark');
        toneBtns.forEach((item) => item.setAttribute('aria-pressed', String(item === btn)));
      });
    });

    copyBtn?.addEventListener('click', async () => {
      const text = copyBtn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        /* clipboard blocked */
      }
      const label = copyBtn.dataset.copyLabel ?? '复制';
      copyBtn.textContent = copyBtn.dataset.copiedLabel ?? '已复制';
      setTimeout(() => {
        copyBtn.textContent = label;
      }, 1400);
    });
  });
</script>
