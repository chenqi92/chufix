---
import { site } from '~/config/site';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';
import { t } from '~/i18n/strings';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocaleFromUrl(Astro.url);
const homeHref = locale === 'en' ? '/en/' : '/';
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a href={homeHref} class="site-nav__brand" aria-label={site.title}>
      <img src="/chufix.png" alt="" class="site-nav__logo" />
      <span class="site-nav__title">{site.title}</span>
      <span class="site-nav__version">v{site.version}</span>
    </a>

    <nav class="site-nav__menu" aria-label={locale === 'en' ? 'Main' : '主导航'}>
      <a href={prefixHref('/components/', locale)} class="site-nav__menu-link">{t(locale, 'nav.menu.components')}</a>
      <a href={prefixHref('/charts/', locale)} class="site-nav__menu-link">{t(locale, 'nav.menu.charts')}</a>
      <a href={prefixHref('/blocks/', locale)} class="site-nav__menu-link">{t(locale, 'nav.menu.blocks')}</a>
    </nav>

    <div class="site-nav__search">
      <label class="cf-input cf-input--filled cf-input--lg">
        <span class="cf-input__prefix">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="5"/><path d="M14 14l-3-3" stroke-linecap="round"/></svg>
        </span>
        <input class="cf-input__native" type="search" placeholder={t(locale, 'nav.search.placeholder')} />
        <span class="cf-input__suffix"><kbd class="site-nav__kbd">{t(locale, 'nav.search.kbd')}</kbd></span>
      </label>
    </div>

    <nav class="site-nav__actions">
      <a href={site.github} target="_blank" rel="noopener" class="cf-btn cf-btn--ghost cf-btn--sm" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>{t(locale, 'nav.github')}</span>
      </a>
      <LanguageSwitcher />
      <ThemeToggle />
    </nav>
  </div>
</header>
