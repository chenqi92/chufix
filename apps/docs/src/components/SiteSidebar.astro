---
import { sidebar, pickLabel } from '~/config/site';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
function isActive(href: string) {
  const norm = href.replace(/\/$/, '') || '/';
  return norm === currentPath;
}
---

<aside class="site-sidebar" data-site-sidebar>
  <nav>
    {sidebar.map((group) => (
      <div class="site-sidebar__group">
        <h3 class="site-sidebar__title">{pickLabel(group.label, locale)}</h3>
        <ul class="site-sidebar__list">
          {group.items.map((item) => {
            const href = prefixHref(item.href, locale);
            return (
              <li>
                <a
                  href={href}
                  class:list={['site-sidebar__link', isActive(href) && 'is-active']}
                  aria-current={isActive(href) ? 'page' : undefined}
                >
                  {pickLabel(item.label, locale)}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script is:inline>
  (() => {
    const sidebar = document.querySelector('[data-site-sidebar]');
    if (!(sidebar instanceof HTMLElement)) return;

    const key = 'chufix:docs-sidebar-scroll';
    const saved = sessionStorage.getItem(key);
    if (saved !== null) {
      requestAnimationFrame(() => {
        sidebar.scrollTop = Number(saved) || 0;
      });
    }

    let frame = 0;
    sidebar.addEventListener(
      'scroll',
      () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          sessionStorage.setItem(key, String(sidebar.scrollTop));
        });
      },
      { passive: true },
    );

    sidebar.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) {
        sessionStorage.setItem(key, String(sidebar.scrollTop));
      }
    });
  })();
</script>
