---
import type { MarkdownHeading } from 'astro';
import { getLocaleFromUrl } from '~/i18n/utils';
import { t } from '~/i18n/strings';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const locale = getLocaleFromUrl(Astro.url);
---

{items.length > 0 && (
  <aside class="site-toc">
    <p class="site-toc__title">{t(locale, 'docs.toc.title')}</p>
    <ul class="site-toc__list">
      {items.map((h) => (
        <li class:list={[`site-toc__item--d${h.depth}`]}>
          <a href={`#${h.slug}`} class="site-toc__link" data-toc-link={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<script is:inline>
  (function () {
    const links = document.querySelectorAll('[data-toc-link]');
    if (!links.length) return;
    const idToLink = new Map();
    links.forEach((a) => idToLink.set(a.dataset.tocLink, a));

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const link = idToLink.get(e.target.id);
          if (!link) return;
          if (e.isIntersecting) {
            document.querySelectorAll('.site-toc__link.is-active').forEach((n) => n.classList.remove('is-active'));
            link.classList.add('is-active');
          }
        });
      },
      { root: null, rootMargin: '-96px 0px -72% 0px', threshold: 0 },
    );
    idToLink.forEach((_, id) => {
      const node = document.getElementById(id);
      if (node) obs.observe(node);
    });
  })();
</script>
