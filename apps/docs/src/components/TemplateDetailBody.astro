---
import DocCodeWorkspace from '~/components/DocCodeWorkspace.astro';
import TemplatePreview from '~/components/TemplatePreview.vue';
import { buildWorkspaceBundles } from '~/components/docCode';
import { CATEGORIES } from '~/templates/types';
import type { TemplateMeta } from '~/templates/types';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

interface Props { template: TemplateMeta }
const { template } = Astro.props;
const cat = CATEGORIES.find((c) => c.id === template.category);

const locale = getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
const backLabel = isEn ? '← All Templates' : '← 所有工程方案';
const footText = isEn
  ? 'Want more templates? Open an issue at '
  : '想要更多工程方案？提 issue 到 ';

const bundles = buildWorkspaceBundles({
  vueFiles: template.vueFiles,
  reactFiles: template.reactFiles,
});

const fileCount = Object.keys(template.vueFiles ?? template.reactFiles ?? {}).length;
const frameworks: string[] = [];
if (template.vueFiles && Object.keys(template.vueFiles).length) frameworks.push('Vue');
if (template.reactFiles && Object.keys(template.reactFiles).length) frameworks.push('React');

const previewHeight = template.previewHeight ?? 'min(820px, 88vh)';
const workspaceHeight = template.workspaceHeight ?? 'min(620px, 70vh)';
const codeToggleLabel = isEn ? 'View code' : '查看代码';
const codeToggleHideLabel = isEn ? 'Hide code' : '收起代码';
---

<div class="tmpl-detail">
  <header class="tmpl-detail__head">
    <a href={prefixHref('/templates/', locale)} class="tmpl-detail__back">{backLabel}</a>
    <span class="tmpl-detail__cat">{cat?.label ?? template.category}</span>
    <h1>{template.name}</h1>
    <p>{template.description}</p>
    <div class="tmpl-detail__meta">
      {frameworks.map((f) => <span class={`tmpl-detail__chip tmpl-detail__chip--${f.toLowerCase()}`}>{f}</span>)}
      <span class="tmpl-detail__chip">{fileCount} {isEn ? 'files' : '文件'}</span>
    </div>
  </header>

  {template.Preview ? (
    <section class="tmpl-stage">
      <div class="tmpl-stage__preview" style={`min-height: ${previewHeight}; height: ${previewHeight};`}>
        <TemplatePreview templateId={template.id} client:only="vue" />
      </div>

      <div class="tmpl-stage__code-section" data-collapsed="true" data-tmpl-code>
        <button class="tmpl-stage__toggle" type="button" aria-expanded="false" data-tmpl-code-toggle data-show-label={codeToggleLabel} data-hide-label={codeToggleHideLabel}>
          <svg class="tmpl-stage__toggle-icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="tmpl-stage__toggle-label">{codeToggleLabel}</span>
        </button>
        <div class="tmpl-stage__code-body">
          <DocCodeWorkspace
            bundles={bundles}
            title={template.workspaceTitle ?? `${template.id} · source`}
            rootLabel={template.workspaceRoot ?? template.id}
            height={workspaceHeight}
          />
        </div>
      </div>
    </section>
  ) : (
    <DocCodeWorkspace
      bundles={bundles}
      title={template.workspaceTitle ?? `${template.id} · source`}
      rootLabel={template.workspaceRoot ?? template.id}
      height={workspaceHeight}
    />
  )}

  <footer class="tmpl-detail__foot">
    <p>{footText}<a href="https://github.com/chenqi92/chufix" target="_blank" rel="noopener">chenqi92/chufix</a>{isEn ? '.' : '。'}</p>
  </footer>
</div>

<script>
  // 演示底部「查看代码」折叠/展开。和组件文档里 DemoFrame 的交互一致。
  function bindTemplateCodeToggles() {
    document.querySelectorAll<HTMLElement>('[data-tmpl-code]').forEach((section) => {
      if (section.dataset.bound === 'true') return;
      const toggle = section.querySelector<HTMLButtonElement>('[data-tmpl-code-toggle]');
      const label = toggle?.querySelector<HTMLSpanElement>('.tmpl-stage__toggle-label');
      if (!toggle || !label) return;
      section.dataset.bound = 'true';
      const showLabel = toggle.dataset.showLabel ?? 'View code';
      const hideLabel = toggle.dataset.hideLabel ?? 'Hide code';
      toggle.addEventListener('click', () => {
        const isCollapsed = section.getAttribute('data-collapsed') !== 'false';
        const nextCollapsed = !isCollapsed; // 当前展开则收起，反之亦然
        section.setAttribute('data-collapsed', String(nextCollapsed));
        toggle.setAttribute('aria-expanded', String(!nextCollapsed));
        label.textContent = nextCollapsed ? showLabel : hideLabel;
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindTemplateCodeToggles, { once: true });
  } else {
    bindTemplateCodeToggles();
  }
</script>

<style>
  .tmpl-detail {
    max-width: 1480px;
    margin: 0 auto;
    padding: 24px 24px 80px;
    font-family: var(--font-sans);
  }
  .tmpl-detail__head { margin-bottom: 20px; }
  .tmpl-detail__back {
    display: inline-block;
    color: var(--fg-3);
    font-size: var(--t-12);
    text-decoration: none;
    margin-bottom: 12px;
  }
  .tmpl-detail__back:hover { color: var(--fg-1); text-decoration: none; }
  .tmpl-detail__cat {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent-1);
    font-size: var(--t-11);
    font-weight: var(--w-medium);
    margin-bottom: 8px;
  }
  .tmpl-detail__head h1 {
    margin: 0;
    font-size: var(--t-22);
    font-weight: var(--w-medium);
    color: var(--fg-1);
  }
  .tmpl-detail__head p {
    margin: 8px 0 0;
    color: var(--fg-2);
    font-size: var(--t-14);
    line-height: 1.6;
  }
  .tmpl-detail__meta {
    margin-top: 10px;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tmpl-detail__chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    font-size: var(--t-11);
    font-weight: var(--w-medium);
    background: var(--bg-2);
    color: var(--fg-3);
    border: 1px solid var(--line-1);
  }
  .tmpl-detail__chip--vue {
    color: oklch(70% 0.16 150);
    border-color: color-mix(in oklch, oklch(70% 0.16 150), transparent 70%);
  }
  .tmpl-detail__chip--react {
    color: oklch(70% 0.13 220);
    border-color: color-mix(in oklch, oklch(70% 0.13 220), transparent 70%);
  }
  .tmpl-stage {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .tmpl-stage__preview {
    display: flex;
    flex-direction: column;
  }
  .tmpl-stage__preview > :global(div),
  .tmpl-stage__preview > :global(*) {
    flex: 1;
    min-height: 0;
  }
  .tmpl-stage__code-section {
    margin-top: 12px;
    border: 1px solid var(--line-1);
    border-radius: var(--r-6);
    overflow: hidden;
    background: var(--bg-1);
  }
  .tmpl-stage__toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 10px 14px;
    background: var(--bg-2);
    border: 0;
    border-bottom: 1px solid var(--line-1);
    color: var(--fg-2);
    font-family: var(--font-sans);
    font-size: var(--t-12);
    cursor: pointer;
    text-align: left;
  }
  .tmpl-stage__toggle:hover { color: var(--fg-1); }
  .tmpl-stage__toggle-icon {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .tmpl-stage__code-section[data-collapsed='false'] .tmpl-stage__toggle-icon {
    transform: rotate(180deg);
  }
  .tmpl-stage__code-section[data-collapsed='true'] .tmpl-stage__toggle {
    border-bottom: 0;
  }
  .tmpl-stage__code-body {
    display: none;
    padding: 0;
  }
  .tmpl-stage__code-section[data-collapsed='false'] .tmpl-stage__code-body {
    display: block;
  }
  .tmpl-detail__foot {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line-1);
    color: var(--fg-3);
    font-size: var(--t-12);
  }
  .tmpl-detail__foot a { color: var(--accent-1); }
</style>
