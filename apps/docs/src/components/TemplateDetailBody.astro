---
import DocCodeWorkspace from '~/components/DocCodeWorkspace.astro';
import TemplatePreview from '~/components/TemplatePreview.vue';
import { buildWorkspaceBundles } from '~/components/docCode';
import { CATEGORIES } from '~/templates/types';
import type { TemplateMeta } from '~/templates/types';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

interface Props { template: TemplateMeta }
const { template } = Astro.props;
const cat = CATEGORIES.find((c) => c.id === template.category);

const locale = getLocaleFromUrl(Astro.url);
const isEn = locale === 'en';
const backLabel = isEn ? '← All Templates' : '← 所有工程方案';
const footText = isEn
  ? 'Want more templates? Open an issue at '
  : '想要更多工程方案？提 issue 到 ';

const bundles = buildWorkspaceBundles({
  vueFiles: template.vueFiles,
  reactFiles: template.reactFiles,
});

const fileCount = Object.keys(template.vueFiles ?? template.reactFiles ?? {}).length;
const frameworks: string[] = [];
if (template.vueFiles && Object.keys(template.vueFiles).length) frameworks.push('Vue');
if (template.reactFiles && Object.keys(template.reactFiles).length) frameworks.push('React');

const previewHeight = template.previewHeight ?? 'min(820px, 88vh)';
const workspaceHeight = template.workspaceHeight ?? 'min(620px, 70vh)';
---

<div class="tmpl-detail">
  <header class="tmpl-detail__head">
    <a href={prefixHref('/templates/', locale)} class="tmpl-detail__back">{backLabel}</a>
    <span class="tmpl-detail__cat">{cat?.label ?? template.category}</span>
    <h1>{template.name}</h1>
    <p>{template.description}</p>
    <div class="tmpl-detail__meta">
      {frameworks.map((f) => <span class={`tmpl-detail__chip tmpl-detail__chip--${f.toLowerCase()}`}>{f}</span>)}
      <span class="tmpl-detail__chip">{fileCount} {isEn ? 'files' : '文件'}</span>
    </div>
  </header>

  {template.Preview ? (
    <section class="tmpl-stage" data-tmpl-stage data-source-open="false">
      <div class="tmpl-stage__preview" style={`min-height: ${previewHeight}; height: ${previewHeight};`}>
        <TemplatePreview templateId={template.id} client:only="vue" />
      </div>

      <div class="tmpl-stage__source" data-source-pane>
        <header class="tmpl-stage__source-bar">
          <span class="tmpl-stage__source-title">{isEn ? 'Source code' : '源码'}</span>
          <button class="tmpl-stage__source-close" type="button" data-source-close aria-label={isEn ? 'Hide source' : '关闭源码'}>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M3 3l10 10M13 3L3 13" stroke-linecap="round" />
            </svg>
          </button>
        </header>
        <DocCodeWorkspace
          bundles={bundles}
          title={template.workspaceTitle ?? `${template.id} · source`}
          rootLabel={template.workspaceRoot ?? template.id}
          height={workspaceHeight}
        />
      </div>
    </section>
  ) : (
    <DocCodeWorkspace
      bundles={bundles}
      title={template.workspaceTitle ?? `${template.id} · source`}
      rootLabel={template.workspaceRoot ?? template.id}
      height={workspaceHeight}
    />
  )}

  <footer class="tmpl-detail__foot">
    <p>{footText}<a href="https://github.com/chenqi92/chufix" target="_blank" rel="noopener">chenqi92/chufix</a>{isEn ? '.' : '。'}</p>
  </footer>
</div>

<script>
  // 由 admin-mini 的 Toolbar 「查看源码」按钮通过 CustomEvent 触发；这里切换 stage 的 data-source-open。
  const stage = document.querySelector<HTMLElement>('[data-tmpl-stage]');
  if (stage) {
    window.addEventListener('chufix-tpl:toggle-source', (e) => {
      const open = !!(e as CustomEvent<{ open: boolean }>).detail?.open;
      stage.setAttribute('data-source-open', String(open));
      if (open) {
        const pane = stage.querySelector<HTMLElement>('[data-source-pane]');
        pane?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    stage.querySelector<HTMLButtonElement>('[data-source-close]')?.addEventListener('click', () => {
      stage.setAttribute('data-source-open', 'false');
      window.dispatchEvent(new CustomEvent('chufix-tpl:sync-source', { detail: { open: false } }));
    });
  }
</script>

<style>
  .tmpl-detail {
    max-width: 1480px;
    margin: 0 auto;
    padding: 24px 24px 80px;
    font-family: var(--font-sans);
  }
  .tmpl-detail__head { margin-bottom: 20px; }
  .tmpl-detail__back {
    display: inline-block;
    color: var(--fg-3);
    font-size: var(--t-12);
    text-decoration: none;
    margin-bottom: 12px;
  }
  .tmpl-detail__back:hover { color: var(--fg-1); text-decoration: none; }
  .tmpl-detail__cat {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    background: var(--accent-soft);
    color: var(--accent-1);
    font-size: var(--t-11);
    font-weight: var(--w-medium);
    margin-bottom: 8px;
  }
  .tmpl-detail__head h1 {
    margin: 0;
    font-size: var(--t-22);
    font-weight: var(--w-medium);
    color: var(--fg-1);
  }
  .tmpl-detail__head p {
    margin: 8px 0 0;
    color: var(--fg-2);
    font-size: var(--t-14);
    line-height: 1.6;
  }
  .tmpl-detail__meta {
    margin-top: 10px;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tmpl-detail__chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    font-size: var(--t-11);
    font-weight: var(--w-medium);
    background: var(--bg-2);
    color: var(--fg-3);
    border: 1px solid var(--line-1);
  }
  .tmpl-detail__chip--vue {
    color: oklch(70% 0.16 150);
    border-color: color-mix(in oklch, oklch(70% 0.16 150), transparent 70%);
  }
  .tmpl-detail__chip--react {
    color: oklch(70% 0.13 220);
    border-color: color-mix(in oklch, oklch(70% 0.13 220), transparent 70%);
  }
  .tmpl-stage {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .tmpl-stage__preview {
    display: flex;
    flex-direction: column;
  }
  .tmpl-stage__preview > :global(div),
  .tmpl-stage__preview > :global(*) {
    flex: 1;
    min-height: 0;
  }
  .tmpl-stage__source {
    display: none;
    flex-direction: column;
    gap: 0;
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--r-6);
    overflow: hidden;
  }
  .tmpl-stage[data-source-open='true'] .tmpl-stage__source {
    display: flex;
  }
  .tmpl-stage__source-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line-1);
  }
  .tmpl-stage__source-title {
    font-size: var(--t-12);
    color: var(--fg-2);
    font-weight: var(--w-medium);
  }
  .tmpl-stage__source-close {
    background: transparent;
    border: 1px solid var(--line-1);
    color: var(--fg-2);
    width: 24px;
    height: 24px;
    border-radius: var(--r-4);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .tmpl-stage__source-close:hover { color: var(--fg-1); }
  .tmpl-detail__foot {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line-1);
    color: var(--fg-3);
    font-size: var(--t-12);
  }
  .tmpl-detail__foot a { color: var(--accent-1); }
</style>
