---
import CategoryTabs from '~/components/CategoryTabs.astro';
import { templates } from '~/templates/registry';
import { CATEGORIES } from '~/templates/types';
import type { TemplateMeta } from '~/templates/types';
import { getLocaleFromUrl, prefixHref } from '~/i18n/utils';

const locale = getLocaleFromUrl(Astro.url);

const isEn = locale === 'en';
const heroTitle = isEn ? 'Templates · multi-page projects' : '工程方案 · 多页面工程';
const heroLede = isEn
  ? "Beyond single-page blocks: ready-to-run multi-page apps assembled entirely from ChuFix components. Open one to see a fully interactive admin console — menu / breadcrumb / multiple pages / theme / density / accent / locale — all wired up. Source code is available under the in-demo View source button."
  : '在单页 Blocks 之外的更大单位：完全由 ChuFix 组件搭起来的可交互多页面工程。点开任意条目即可在浏览器里实际跑一套后台——菜单、面包屑、多个真实页面、主题、密度、主色、语言切换全部已接好；源码可通过演示内置的「查看源码」按钮展开。';

function frameworks(t: TemplateMeta): string[] {
  const fw: string[] = [];
  if (t.vueFiles && Object.keys(t.vueFiles).length) fw.push('Vue');
  if (t.reactFiles && Object.keys(t.reactFiles).length) fw.push('React');
  return fw;
}

function fileCount(t: TemplateMeta): number {
  return Object.keys(t.vueFiles ?? t.reactFiles ?? {}).length;
}

const grouped = CATEGORIES
  .map((cat) => ({ ...cat, items: templates.filter((t) => t.category === cat.id) }))
  .filter((g) => g.items.length > 0);
const defaultCat = grouped[0]?.id ?? CATEGORIES[0].id;

const emptyHint = isEn
  ? 'More templates are on the way. Drop a request at the repo issues if there is something you need.'
  : '更多工程方案陆续补充。如有需要可在仓库 issues 留言。';
---

<div class="templates-page">
  <header class="templates-hero">
    <h1 class="templates-hero__title">{heroTitle}</h1>
    <p class="templates-hero__lede">{heroLede}</p>
  </header>

  {grouped.length === 0 ? (
    <div class="templates-empty">{emptyHint}</div>
  ) : (
    <CategoryTabs tabs={grouped.map((g) => ({ id: g.id, label: g.label }))} defaultId={defaultCat}>
      {grouped.map((g) => (
        <div data-cat-panel={g.id} data-active={g.id === defaultCat ? 'true' : 'false'}>
          <p class="templates-page__cat-desc">{g.description}</p>
          <div class="cf-gallery cf-gallery--grid">
            {g.items.map((t) => {
              const fw = frameworks(t);
              const count = fileCount(t);
              return (
                <a class="cf-gallery-card tmpl-card" href={prefixHref(`/templates/${t.id}/`, locale)}>
                  <div class="tmpl-card__thumb" aria-hidden="true">
                    <div class="tmpl-mini">
                      <div class="tmpl-mini__topbar">
                        <span class="tmpl-mini__dot tmpl-mini__dot--r" />
                        <span class="tmpl-mini__dot tmpl-mini__dot--y" />
                        <span class="tmpl-mini__dot tmpl-mini__dot--g" />
                        <span class="tmpl-mini__brand">{t.name.split('·')[0].trim()}</span>
                      </div>
                      <div class="tmpl-mini__body">
                        <aside class="tmpl-mini__sidebar">
                          <span class="tmpl-mini__sidebar-item tmpl-mini__sidebar-item--active" />
                          <span class="tmpl-mini__sidebar-item" />
                          <span class="tmpl-mini__sidebar-item" />
                          <span class="tmpl-mini__sidebar-item" />
                          <span class="tmpl-mini__sidebar-item" />
                          <span class="tmpl-mini__sidebar-item tmpl-mini__sidebar-item--short" />
                        </aside>
                        <main class="tmpl-mini__main">
                          <div class="tmpl-mini__kpis">
                            <div class="tmpl-mini__kpi" />
                            <div class="tmpl-mini__kpi" />
                            <div class="tmpl-mini__kpi" />
                            <div class="tmpl-mini__kpi" />
                          </div>
                          <div class="tmpl-mini__table">
                            <div class="tmpl-mini__row tmpl-mini__row--head" />
                            <div class="tmpl-mini__row" />
                            <div class="tmpl-mini__row" />
                            <div class="tmpl-mini__row" />
                            <div class="tmpl-mini__row" />
                          </div>
                        </main>
                      </div>
                    </div>
                  </div>
                  <div class="tmpl-card__body">
                    <div class="tmpl-card__head">
                      <div class="tmpl-card__name">{t.name}</div>
                      <div class="tmpl-card__meta">
                        {fw.map((f) => <span class={`tmpl-card__chip tmpl-card__chip--${f.toLowerCase()}`}>{f}</span>)}
                        <span class="tmpl-card__chip tmpl-card__chip--count">{count} {isEn ? 'files' : '文件'}</span>
                      </div>
                    </div>
                    <div class="tmpl-card__desc">{t.description}</div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </CategoryTabs>
  )}
</div>

<style>
  .templates-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    font-family: var(--font-sans);
  }
  .templates-hero { margin: 0 0 24px; }
  .templates-hero__title {
    margin: 0;
    font-size: var(--t-26);
    font-weight: var(--w-medium);
    color: var(--fg-1);
    letter-spacing: -0.01em;
  }
  .templates-hero__lede {
    margin: 8px 0 0;
    color: var(--fg-2);
    font-size: var(--t-14);
    line-height: 1.65;
    max-width: 860px;
  }
  .templates-page__cat-desc {
    color: var(--fg-3);
    font-size: var(--t-12);
    margin: 0 0 14px;
  }
  .templates-empty {
    margin-top: 24px;
    padding: 32px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r-6);
    color: var(--fg-3);
    text-align: center;
    font-size: var(--t-13);
  }
  .cf-gallery--grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 18px;
  }
  .tmpl-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    overflow: hidden;
  }
  .tmpl-card, .tmpl-card:hover { text-decoration: none; }
  .tmpl-card__thumb {
    padding: 12px;
    min-height: 220px;
    background: linear-gradient(180deg, color-mix(in oklch, var(--bg-inset), var(--accent-soft) 18%), var(--bg-inset));
    border-bottom: 1px solid var(--line-1);
  }
  .tmpl-mini {
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--r-4);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    min-height: 196px;
  }
  .tmpl-mini__topbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--line-1);
    background: var(--bg-2);
  }
  .tmpl-mini__dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
  .tmpl-mini__dot--r { background: oklch(70% 0.15 25); }
  .tmpl-mini__dot--y { background: oklch(85% 0.15 90); }
  .tmpl-mini__dot--g { background: oklch(72% 0.16 145); }
  .tmpl-mini__brand {
    margin-left: 6px;
    font-size: 10px;
    color: var(--fg-3);
    font-weight: var(--w-medium);
  }
  .tmpl-mini__body {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 6px;
    flex: 1;
    padding: 8px;
    min-height: 0;
  }
  .tmpl-mini__sidebar {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tmpl-mini__sidebar-item {
    height: 8px;
    border-radius: var(--r-2);
    background: color-mix(in oklch, var(--fg-3), transparent 70%);
  }
  .tmpl-mini__sidebar-item--active {
    background: var(--accent-1);
  }
  .tmpl-mini__sidebar-item--short { width: 60%; }
  .tmpl-mini__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .tmpl-mini__kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .tmpl-mini__kpi {
    height: 28px;
    background: color-mix(in oklch, var(--bg-2), var(--accent-soft) 40%);
    border-radius: var(--r-2);
    border: 1px solid var(--line-1);
  }
  .tmpl-mini__table {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
  }
  .tmpl-mini__row {
    height: 10px;
    border-radius: var(--r-2);
    background: color-mix(in oklch, var(--fg-3), transparent 80%);
  }
  .tmpl-mini__row--head {
    background: color-mix(in oklch, var(--accent-1), transparent 75%);
  }
  .tmpl-card__body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tmpl-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .tmpl-card__name {
    font-size: var(--t-14);
    font-weight: var(--w-medium);
    color: var(--fg-1);
  }
  .tmpl-card__meta {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    flex-shrink: 0;
  }
  .tmpl-card__chip {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border-radius: var(--r-pill);
    font-size: var(--t-10);
    font-weight: var(--w-medium);
    background: var(--bg-2);
    color: var(--fg-3);
    border: 1px solid var(--line-1);
  }
  .tmpl-card__chip--vue {
    color: oklch(70% 0.16 150);
    border-color: color-mix(in oklch, oklch(70% 0.16 150), transparent 70%);
  }
  .tmpl-card__chip--react {
    color: oklch(70% 0.13 220);
    border-color: color-mix(in oklch, oklch(70% 0.13 220), transparent 70%);
  }
  .tmpl-card__chip--count { color: var(--fg-3); }
  .tmpl-card__desc {
    color: var(--fg-2);
    font-size: var(--t-12);
    line-height: 1.6;
  }
</style>
