---
import '~/styles/global.css';
import { site } from '~/config/site';
import { getLocaleFromUrl } from '~/i18n/utils';
import { t } from '~/i18n/strings';
import SiteNav from '~/components/SiteNav.astro';

interface Props {
  title?: string;
  description?: string;
}
const locale = getLocaleFromUrl(Astro.url);
const htmlLang = locale === 'en' ? 'en' : 'zh-CN';

const { title, description = t(locale, 'site.description') } = Astro.props;
const tagline = t(locale, 'site.tagline');
const fullTitle = title ? `${title} · ${site.title}` : `${site.title} · ${tagline}`;

const statusLabel = site.status.label[locale];
const announceTitle = site.status.announcementTitle[locale];
const announceBody = site.status.announcement[locale];
const updatedLabel = t(locale, 'announce.updated');
const closeAnnouncementLabel = locale === 'en' ? 'Dismiss announcement' : '关闭公告';
const announcementStorageKey = `chufix:announcement:${site.status.updatedAt}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <SiteNav />
    <aside
      class="site-announcement"
      aria-label={announceTitle}
      data-site-announcement
      data-announcement-key={announcementStorageKey}
    >
      <div class="site-announcement__inner">
        <span class="site-announcement__badge">{statusLabel}</span>
        <strong>{announceTitle}</strong>
        <span>{announceBody}</span>
        <span class="site-announcement__date">{updatedLabel} {site.status.updatedAt}</span>
        <button
          class="site-announcement__close"
          type="button"
          aria-label={closeAnnouncementLabel}
          title={closeAnnouncementLabel}
          data-site-announcement-close
        >
          ×
        </button>
      </div>
    </aside>
    <script is:inline>
      (() => {
        const announcement = document.querySelector('[data-site-announcement]');
        const close = document.querySelector('[data-site-announcement-close]');
        const key = announcement?.getAttribute('data-announcement-key');
        if (!announcement || !close || !key) return;
        try {
          if (localStorage.getItem(key) === 'hidden') {
            announcement.hidden = true;
          }
          close.addEventListener('click', () => {
            localStorage.setItem(key, 'hidden');
            announcement.hidden = true;
          });
        } catch {
          close.addEventListener('click', () => {
            announcement.hidden = true;
          });
        }
      })();
    </script>
    <slot />
    <div id="docs-toaster-root"></div>
    <script>
      import { createApp } from 'vue';
      import { CfToaster } from '@chufix-design/vue';

      const root = document.getElementById('docs-toaster-root');
      if (root && !root.dataset.mounted) {
        root.dataset.mounted = 'true';
        createApp(CfToaster, { position: 'top-right', teleport: false }).mount(root);
      }
    </script>
  </body>
</html>
