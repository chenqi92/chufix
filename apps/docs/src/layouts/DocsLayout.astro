---
import BaseLayout from './BaseLayout.astro';
import SiteSidebar from '~/components/SiteSidebar.astro';
import SiteToc from '~/components/SiteToc.astro';
import type { MarkdownHeading } from 'astro';
import { sidebar } from '~/config/site';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}
const { title, description, headings = [] } = Astro.props;

const flat = sidebar.flatMap((g) => g.items);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const idx = flat.findIndex((i) => (i.href.replace(/\/$/, '') || '/') === currentPath);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;
---

<BaseLayout title={title} description={description}>
  <div class="docs-shell">
    <SiteSidebar />
    <main class="docs-main" data-docs-main>
      <article class="cf-prose">
        <header class="docs-header">
          <h1>{title}</h1>
          {description && <p class="docs-header__lede">{description}</p>}
        </header>
        <slot />
      </article>

      <nav class="docs-pager">
        {prev ? (
          <a href={prev.href} class="docs-pager__link docs-pager__link--prev">
            <span class="docs-pager__dir">← 上一篇</span>
            <span class="docs-pager__label">{prev.label}</span>
          </a>
        ) : <span />}
        {next ? (
          <a href={next.href} class="docs-pager__link docs-pager__link--next">
            <span class="docs-pager__dir">下一篇 →</span>
            <span class="docs-pager__label">{next.label}</span>
          </a>
        ) : <span />}
      </nav>
    </main>
    <SiteToc headings={headings} />
  </div>
</BaseLayout>
