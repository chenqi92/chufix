---
import { Image } from 'astro:assets';
import SplashLayout from '~/layouts/SplashLayout.astro';
import DemoFrame from '~/components/DemoFrame.astro';
import BasicVue from '~/components/demos/button/BasicVue.vue';
import { site } from '~/config/site';
import logo from '~/assets/chufix.png';
---

<SplashLayout>
  <section class="hero">
    <div class="hero__inner">
      <Image src={logo} alt="" class="hero__logo" widths={[160, 220]} sizes="220px" />
      <h1 class="hero__title">{site.nameZh}</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <p class="hero__brand">{site.title} · 双框架同源 · CSS 变量主题 · 可装包也可拷源码 · 纯 HTML/JS 也能用</p>
      <div class="hero__cta">
        <a href="/getting-started/installation/" class="cf-btn cf-btn--lg">快速开始</a>
        <a href="/getting-started/vanilla/" class="cf-btn cf-btn--secondary cf-btn--lg">纯 HTML 用法</a>
        <a href="/components/" class="cf-btn cf-btn--tertiary cf-btn--lg">浏览组件</a>
        <a href={site.github} target="_blank" rel="noopener" class="cf-btn cf-btn--ghost cf-btn--lg">GitHub →</a>
      </div>
    </div>
  </section>

  <section class="splash-section">
    <h2 class="splash-section__title">为什么是础件</h2>
    <div class="cf-feature-grid">
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">双框架同源</div>
        <div class="cf-card__body">
          Vue 3 与 React 共用同一套 design token、同一套类名、同一套交互行为。从 Vue 项目搬到 React 项目，零负担。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">零运行时主题</div>
        <div class="cf-card__body">
          所有颜色、半径、阴影都走 CSS 变量。切主题只需改 <code>[data-theme]</code>，没有 JS 主题工厂。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">两种用法</div>
        <div class="cf-card__body">
          <code>npm i @chufix/vue</code> 当传统组件库用，或 <code>npx chufix add</code> 把源码直接拷进自己仓库。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">纯 HTML 也能用</div>
        <div class="cf-card__body">
          所有视觉走 <code>cf-*</code> CSS 类名，不写任何 Vue/React 也能拿到 90% 的视觉。
          一个 <code>&lt;link&gt;</code> 标签搞定。
        </div>
      </article>
    </div>
  </section>

  <section class="splash-section">
    <h2 class="splash-section__title">一眼看到效果</h2>
    <p class="splash-section__lede">
      下面是真实可交互的实例，不是截图。代码默认折叠，展开后可在 Vue / React / CLI 三种来源之间切换并一键复制。
    </p>
    <DemoFrame
      vueCode={`<script setup lang="ts">
import { CfButton } from '@chufix/vue';
</script>

<template>
  <CfButton variant="primary">主要</CfButton>
  <CfButton variant="secondary">次要</CfButton>
  <CfButton variant="tertiary">三级</CfButton>
  <CfButton variant="ghost">幽灵</CfButton>
  <CfButton variant="danger">危险</CfButton>
</template>`}
      reactCode={`import { CfButton } from '@chufix/react';

export default () => (
  <>
    <CfButton variant="primary">主要</CfButton>
    <CfButton variant="secondary">次要</CfButton>
    <CfButton variant="tertiary">三级</CfButton>
    <CfButton variant="ghost">幽灵</CfButton>
    <CfButton variant="danger">危险</CfButton>
  </>
);`}
      cliCode={`# 任选其一
npm i @chufix/vue
npm i @chufix/react

# 或源码复制（拷贝到自己仓库）
npx chufix add button`}
    >
      <BasicVue client:load />
    </DemoFrame>
  </section>

  <section class="splash-section">
    <h2 class="splash-section__title">现在已经有什么</h2>
    <p class="splash-section__lede">39 个组件，覆盖表单、容器、反馈、数据展示、导航、布局六类高频场景。</p>
    <div class="splash-pills">
      <a href="/components/button/" class="cf-btn cf-btn--secondary">Button</a>
      <a href="/components/input/" class="cf-btn cf-btn--secondary">Input</a>
      <a href="/components/textarea/" class="cf-btn cf-btn--secondary">Textarea</a>
      <a href="/components/select/" class="cf-btn cf-btn--secondary">Select</a>
      <a href="/components/checkbox/" class="cf-btn cf-btn--secondary">Checkbox</a>
      <a href="/components/radio/" class="cf-btn cf-btn--secondary">Radio</a>
      <a href="/components/switch/" class="cf-btn cf-btn--secondary">Switch</a>
      <a href="/components/card/" class="cf-btn cf-btn--secondary">Card</a>
      <a href="/components/modal/" class="cf-btn cf-btn--secondary">Modal</a>
      <a href="/components/tooltip/" class="cf-btn cf-btn--secondary">Tooltip</a>
      <a href="/components/toast/" class="cf-btn cf-btn--secondary">Toast</a>
      <a href="/components/tag/" class="cf-btn cf-btn--secondary">Tag</a>
      <a href="/components/badge/" class="cf-btn cf-btn--secondary">Badge</a>
      <a href="/components/avatar/" class="cf-btn cf-btn--secondary">Avatar</a>
      <a href="/components/tabs/" class="cf-btn cf-btn--secondary">Tabs</a>
      <a href="/components/alert/" class="cf-btn cf-btn--secondary">Alert</a>
      <a href="/components/skeleton/" class="cf-btn cf-btn--secondary">Skeleton</a>
      <a href="/components/divider/" class="cf-btn cf-btn--secondary">Divider</a>
      <a href="/components/empty/" class="cf-btn cf-btn--secondary">Empty</a>
      <a href="/components/progress/" class="cf-btn cf-btn--secondary">Progress</a>
      <a href="/components/breadcrumb/" class="cf-btn cf-btn--secondary">Breadcrumb</a>
      <a href="/components/pagination/" class="cf-btn cf-btn--secondary">Pagination</a>
      <a href="/components/spinner/" class="cf-btn cf-btn--secondary">Spinner</a>
      <a href="/components/searchinput/" class="cf-btn cf-btn--secondary">SearchInput</a>
      <a href="/components/numberinput/" class="cf-btn cf-btn--secondary">NumberInput</a>
      <a href="/components/accordion/" class="cf-btn cf-btn--secondary">Accordion</a>
      <a href="/components/slider/" class="cf-btn cf-btn--secondary">Slider</a>
      <a href="/components/drawer/" class="cf-btn cf-btn--secondary">Drawer</a>
      <a href="/components/popover/" class="cf-btn cf-btn--secondary">Popover</a>
      <a href="/components/dropdown/" class="cf-btn cf-btn--secondary">Dropdown</a>
      <a href="/components/inputgroup/" class="cf-btn cf-btn--secondary">InputGroup</a>
      <a href="/components/otp/" class="cf-btn cf-btn--secondary">OtpInput</a>
      <a href="/components/form/" class="cf-btn cf-btn--secondary">Form</a>
      <a href="/components/combobox/" class="cf-btn cf-btn--secondary">Combobox</a>
      <a href="/components/taginput/" class="cf-btn cf-btn--secondary">TagInput</a>
      <a href="/components/dropzone/" class="cf-btn cf-btn--secondary">Dropzone</a>
      <a href="/components/colorpicker/" class="cf-btn cf-btn--secondary">ColorPicker</a>
      <a href="/components/datepicker/" class="cf-btn cf-btn--secondary">DatePicker</a>
      <a href="/components/daterangepicker/" class="cf-btn cf-btn--secondary">DateRangePicker</a>
      <a href="/components/" class="cf-btn cf-btn--tertiary">完整清单 →</a>
    </div>
  </section>

  <footer class="splash-footer">
    <p>ChuFix UI · MIT License · v{site.version}</p>
  </footer>
</SplashLayout>
