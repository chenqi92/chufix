---
import { Image } from 'astro:assets';
import SplashLayout from '~/layouts/SplashLayout.astro';
import DemoFrame from '~/components/DemoFrame.astro';
import BasicVue from '~/components/demos/button/BasicVue.vue';
import { site } from '~/config/site';
import logo from '~/assets/chufix.png';
---

<SplashLayout>
  <section class="hero">
    <div class="hero__inner">
      <Image src={logo} alt="" class="hero__logo" widths={[160, 220]} sizes="220px" />
      <h1 class="hero__title">{site.nameZh}</h1>
      <p class="hero__tagline">{site.tagline}</p>
      <p class="hero__brand">{site.title} · 双框架同源 · CSS 变量主题 · 可装包也可拷源码 · 纯 HTML/JS 也能用</p>
      <div class="hero__cta">
        <a href="/getting-started/installation/" class="cf-btn cf-btn--lg">快速开始</a>
        <a href="/getting-started/vanilla/" class="cf-btn cf-btn--secondary cf-btn--lg">纯 HTML 用法</a>
        <a href="/components/" class="cf-btn cf-btn--tertiary cf-btn--lg">浏览组件</a>
        <a href={site.github} target="_blank" rel="noopener" class="cf-btn cf-btn--ghost cf-btn--lg">GitHub →</a>
      </div>
    </div>
  </section>

  <section class="splash-section">
    <h2 class="splash-section__title">为什么是础件</h2>
    <div class="cf-feature-grid">
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">双框架同源</div>
        <div class="cf-card__body">
          Vue 3 与 React 共用同一套 design token、同一套类名、同一套交互行为。从 Vue 项目搬到 React 项目，零负担。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">零运行时主题</div>
        <div class="cf-card__body">
          所有颜色、半径、阴影都走 CSS 变量。切主题只需改 <code>[data-theme]</code>，没有 JS 主题工厂。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">两种用法</div>
        <div class="cf-card__body">
          <code>npm i @chufix-design/vue</code> 当传统组件库用，或 <code>npx chufix add</code> 把源码直接拷进自己仓库。
        </div>
      </article>
      <article class="cf-card cf-card--elevated">
        <div class="cf-card__header">纯 HTML 也能用</div>
        <div class="cf-card__body">
          所有视觉走 <code>cf-*</code> CSS 类名，不写任何 Vue/React 也能拿到 90% 的视觉。
          一个 <code>&lt;link&gt;</code> 标签搞定。
        </div>
      </article>
    </div>
  </section>

  <section class="splash-section">
    <h2 class="splash-section__title">一眼看到效果</h2>
    <p class="splash-section__lede">
      下面是真实可交互的实例，不是截图。代码默认折叠，展开后可在 Vue / React / CLI 三种来源之间切换并一键复制。
    </p>
    <DemoFrame
      vueCode={`<script setup lang="ts">
import { CfButton } from '@chufix-design/vue';
</script>

<template>
  <CfButton variant="primary">主要</CfButton>
  <CfButton variant="secondary">次要</CfButton>
  <CfButton variant="tertiary">三级</CfButton>
  <CfButton variant="ghost">幽灵</CfButton>
  <CfButton variant="danger">危险</CfButton>
</template>`}
      reactCode={`import { CfButton } from '@chufix-design/react';

export default () => (
  <>
    <CfButton variant="primary">主要</CfButton>
    <CfButton variant="secondary">次要</CfButton>
    <CfButton variant="tertiary">三级</CfButton>
    <CfButton variant="ghost">幽灵</CfButton>
    <CfButton variant="danger">危险</CfButton>
  </>
);`}
      cliCode={`# 任选其一
npm i @chufix-design/vue
npm i @chufix-design/react

# 或源码复制（拷贝到自己仓库）
npx chufix add button`}
    >
      <BasicVue client:load />
    </DemoFrame>
  </section>

  <section class="splash-section">
