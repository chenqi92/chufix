{
  "name": "chufix-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "ChuFix UI monorepo — 初见即用的基础组件库",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./packages/* run dev & pnpm --filter=docs dev",
    "dev:vue": "pnpm --filter=@chufix-design/vue dev",
    "dev:react": "pnpm --filter=@chufix-design/react dev",
    "dev:docs": "pnpm --filter=docs dev",
    "build": "pnpm -r --filter=./packages/* run build && pnpm --filter=docs build",
    "build:packages": "pnpm -r --filter=./packages/* run build",
    "build:docs": "pnpm --filter=docs build",
    "icons:sync": "pnpm --filter @chufix-design/icons sync",
    "tokens:check": "node scripts/check-tokens.mjs",
    "smoke": "pnpm --filter @chufix-design/example-vite-vue dev",
    "smoke:build": "pnpm --filter @chufix-design/example-vite-vue build",
    "clean": "pnpm -r exec rimraf dist .astro node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3"
  }
}
