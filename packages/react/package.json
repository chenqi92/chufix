{
  "name": "@chufix-design/react",
  "version": "0.8.1",
  "description": "ChuFix UI for React 18+ —— 初见即用的基础组件库",
  "license": "MIT",
  "author": "chenqi92",
  "homepage": "https://chufix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqi92/chufix.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/chenqi92/chufix/issues"
  },
  "keywords": [
    "chufix",
    "react",
    "react18",
    "component-library",
    "design-system",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@chufix-design/icons": "workspace:*",
    "@chufix-design/tokens": "workspace:*",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
