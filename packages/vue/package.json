{
  "name": "@chufix-design/vue",
  "version": "0.8.0",
  "description": "ChuFix UI for Vue 3 —— 初见即用的基础组件库",
  "license": "MIT",
  "author": "chenqi92",
  "homepage": "https://chufix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqi92/chufix.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/chenqi92/chufix/issues"
  },
  "keywords": [
    "chufix",
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./src/*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "@chufix-design/icons": "workspace:*",
    "@chufix-design/tokens": "workspace:*",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
